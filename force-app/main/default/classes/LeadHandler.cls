    public static void afterUpdate(Map<Id, Lead> oldMap, List<Lead> newList) {
        System.debug('oldMap::<<<' + oldMap);
        System.debug('newList::>>>' + newList);
        try{
            if (isRunning) return;
        isRunning = true;
        Set<Id> leadIdsToSubmit = new Set<Id>();
        for (Lead n : newList) {
            Lead o = oldMap.get(n.Id);

            if (n.Lead_Qualified__c == 'No' && n.Status != 'Qualified' && o.Status == 'Assigned' && n.Status != o.Status) {
                leadIdsToSubmit.add(n.Id);
            }
        }
        System.debug('set of leadIdsToSubmit::>>' + leadIdsToSubmit+ ':::size::>>' + leadIdsToSubmit.size());

        Set<Id> pendingInApproval = new Set<Id>();
        if (!leadIdsToSubmit.isEmpty()) {
            list<ProcessInstance> proesInstance = [SELECT TargetObjectId, Status FROM ProcessInstance WHERE TargetObjectId IN :leadIdsToSubmit AND Status = 'Pending'];
            system.debug('processInstance::>>' + proesInstance);
            for (ProcessInstance pi : proesInstance) {
                pendingInApproval.add((Id)pi.TargetObjectId);
            }
        }

        Map<Id, Lead> leadForOwner = new Map<Id, Lead>();
        if (!leadIdsToSubmit.isEmpty()) {
            leadForOwner = new Map<Id, Lead>([SELECT Id, OwnerId FROM Lead WHERE Id IN :leadIdsToSubmit]);
        }

        System.debug('leadForOwner::>>'+ leadForOwner);

        Set<Id> ownerUserIds = new Set<Id>();
        for (Lead l : leadForOwner.values()) {
            if (String.valueOf(l.OwnerId).startsWith('005')) ownerUserIds.add(l.OwnerId);
        }

        Map<Id, User> ownerUsers = ownerUserIds.isEmpty() ? new Map<Id, User>() : new Map<Id, User>([SELECT Id, ManagerId FROM User WHERE Id IN :ownerUserIds]);

        for (Id leadId : leadIdsToSubmit) {
            if (pendingInApproval.contains(leadId)) continue;

            Lead l = leadForOwner.get(leadId);
            if (l == null) continue;

            if (!String.valueOf(l.OwnerId).startsWith('005')) {
                continue;
            }

            User owner = ownerUsers.get(l.OwnerId);
            if (owner == null || owner.ManagerId == null) {
                continue;
            }

            Approval.ProcessSubmitRequest req = new Approval.ProcessSubmitRequest();
            req.setObjectId(leadId);
            req.setNextApproverIds(new Id[] { owner.ManagerId });
            req.setComments('Lead Qualified = No. Manager approval required to move Status to Qualified.');


            Approval.ProcessResult result = Approval.process(req);
            System.debug('result::<<'+ result);

        }

        List<Task> tasksToInsert = new List<Task>();
        System.debug('newlist::>>'+ newList);
        for (Lead n : newList) {
            Lead o = oldMap.get(n.Id);
            System.debug('newlead::' + n);
            System.debug('oldlead::' + o);
            

            if (o.Status != 'Qualified' && n.Status == 'Qualified') {
                Task t = new Task();
                t.Subject = 'Please add the site visit planned date';
                t.Status  = 'Not Started';
                t.Priority = 'Normal';

                t.WhoId = n.Id;
                t.OwnerId = n.OwnerId;

                tasksToInsert.add(t);
            }
        }

        if (!tasksToInsert.isEmpty()) {
            insert tasksToInsert;
        }

        isRunning = false;
        }
        catch(Exception e){
            system.debug('Error at line: ' + e.getLineNumber() + ' ' + e.getMessage());
        }
        
    }

    
