                                lead.Site_Visit_Planned_Date__c.addError('Site Visit Planned Date must be a current or future date.');
                            }
                        } else if (lead.Status == 'Dropped') {
                            if (String.isBlank(lead.Dropped_Reason__c)) {
                                lead.Dropped_Reason__c.addError('Dropped Reason must be provided.');
                            }
                        } else if (lead.Status == 'Converted') {
                            if (lead.Site_Visit_Planned_Date__c == null) {
                                lead.Site_Visit_Planned_Date__c.addError('Site Visit Planned Date must be filled.');
                            }
                        }
                    } else if (oldLead.Status == 'SV Planned') {
                        // Check status change from 'SV Planned'
                        if (lead.Status == 'Dropped') {
                            if (String.isBlank(lead.Dropped_Reason__c)) {
                                lead.Dropped_Reason__c.addError('Dropped Reason must be provided.');
                            }
                        } else if (lead.Status == 'Converted') {
                            if (lead.Site_Visit_Planned_Date__c == null) {
                                lead.Site_Visit_Planned_Date__c.addError('Site Visit Planned Date must be filled.');
                            }
                        }
                    } else if (oldLead.Status == 'Dropped') {
                        // Check status change from 'Dropped'
                        if (lead.Status == 'Converted') {
                            if (!(lead.Email_Conversation_Done__c || lead.Phone_Conversation_Done__c)) {
                                errorMessages.add('Either Email or Phone conversation must be done.');
                            }
                            // else if (!lead.Is_Qualified__c) {
                            //     lead.Is_Qualified__c.addError('Is Qualified must be true.');
                            // }
                            // else if (lead.Qualification_Criteria__c == null) {
                            //     lead.Qualification_Criteria__c.addError('Please add Qualification Critieria.');
                            // }
                            else if (lead.Site_Visit_Planned_Date__c == null) {
                                lead.Site_Visit_Planned_Date__c.addError('Site Visit Planned Date must be filled.');
                            }
                        }
                    }
                }
                
                //all collected error messages to the lead
                if (!errorMessages.isEmpty()) {
                    lead.addError(String.join(errorMessages, '\n'));
                }
            }
        }
    }

