    public static void updateDuplicateLeadsBeforeUpdate(List<Lead> newLeads, Map<Id, Lead> oldMap){
        try{
            System.debug('newLeads==>'+newLeads);
            System.debug('oldMap==>'+oldMap);
            if (newLeads == null || newLeads.isEmpty() || oldMap == null) {
                return;
            }
            Set<Id> leadsUpdated = new Set<Id>();
            List<String> phones = new List<String>();
            List<String> emails = new List<String>();
            Map<String,Lead> leadByEmailMap = new Map<String,Lead>();
            Map<String,Lead> leadByPhoneMap = new Map<String,Lead>();
            for(Lead lead : newLeads){
                if(lead.Phone != oldMap.get(lead.Id).Phone || lead.Email != oldMap.get(lead.Id).Email || lead.Alternate_Phone__c != oldMap.get(lead.Id).Alternate_Phone__c || lead.Alternate_Email__c != oldMap.get(lead.Id).Alternate_Email__c){
                    system.debug('new lead ===> ' + lead.Lead_Type__c);
                    leadsUpdated.add(lead.Id);
                    if(lead.Phone != null){
                        phones.add(lead.Phone);
                    }
                    if(lead.Email != null){
                        emails.add(lead.Email);
                    }
                    // if(lead.Alternate_Phone__c != null){
                    //     phones.add(lead.Alternate_Phone__c);
                    // }
                    // if(lead.Alternate_Email__c != null){
                    //     emails.add(lead.Alternate_Email__c);
                    // }
                    if(lead.Phone != null && !leadByPhoneMap.containsKey(lead.Phone)){
                        leadByPhoneMap.put(lead.Phone, lead);
                    }
                    if(lead.Email != null && !leadByEmailMap.containsKey(lead.Email)){
                        leadByEmailMap.put(lead.Email, lead);
                    }
                    // if(lead.Alternate_Phone__c != null && !leadByPhoneMap.containsKey(lead.Alternate_Phone__c)){
                    //     leadByPhoneMap.put(lead.Alternate_Phone__c, lead);
                    // }
                    // if(lead.Alternate_Email__c != null && !leadByEmailMap.containsKey(lead.Alternate_Email__c)){
                    //     leadByEmailMap.put(lead.Alternate_Email__c, lead);
                    // }
                }
            }
            if(leadsUpdated.isEmpty()){
                return;
            }
            system.debug('leadsUpdated ===> ' + leadsUpdated);
            system.debug('leadByEmailMap ===> ' + leadByEmailMap);
            system.debug('leadByPhoneMap ===> ' + leadByPhoneMap);
            
            List<Lead> duplicateLeads = new List<Lead>();
            List<Lead> leadstoUpdate = new List<Lead>();
            duplicateLeads = [SELECT Id, Email, Phone, Lead_Type__c, CreatedDate, Status, isConverted FROM Lead WHERE (Phone IN :phones OR Email IN :emails)  AND Id NOT IN :leadsUpdated ORDER BY CreatedDate DESC];
            System.debug('Duplicate Leads: ' + duplicateLeads);
            List<Lead> leadsToDelete = new List<Lead>();
            if(!duplicateLeads.isEmpty()){
                for(Lead dupLead : duplicateLeads){
                    System.debug('dupLead==>'+dupLead);
                    System.debug('leadByPhoneMap.containsKey(dupLead.Phone)==>'+leadByPhoneMap.containsKey(dupLead.phone));
                    //System.debug('leadByPhoneMap.get(dupLead.Phone).Lead_Type__c==>'+leadByPhoneMap.get(dupLead.Phone).Lead_Type__c);
                    if(
                        dupLead.Lead_Type__c == 'Direct' && 
                        
                        (
                            (dupLead.Phone != null && leadByPhoneMap.containsKey(dupLead.Phone) && leadByPhoneMap.get(dupLead.Phone).Lead_Type__c == 'Direct') ||
                           // (dupLead.Alternate_Phone__c != null && leadByPhoneMap.containsKey(dupLead.Alternate_Phone__c) && leadByPhoneMap.get(dupLead.Alternate_Phone__c).Lead_Type__c == 'Direct') || 
                            (dupLead.Email != null && leadByEmailMap.containsKey(dupLead.Email) && leadByEmailMap.get(dupLead.Email).Lead_Type__c == 'Direct') 
                           // (dupLead.Alternate_Email__c != null && leadByEmailMap.containsKey(dupLead.Alternate_Email__c) && leadByEmailMap.get(dupLead.Alternate_Email__c).Lead_Type__c == 'Direct')
                        )
                    ){
                        system.debug('first condition');
                        system.debug('dupLead ===> ' + dupLead);
                        dupLead.Status = 'Re-Enquiry';
                        leadstoUpdate.add(dupLead);
                        system.debug('new lead type ===> ' + leadByPhoneMap.get(dupLead.Phone).Lead_Type__c);
                        if(dupLead.Phone != null && leadByPhoneMap.containsKey(dupLead.Phone) && leadByPhoneMap.get(dupLead.Phone).Lead_Type__c == 'Direct'){
                            Lead phoneLead = leadByPhoneMap.get(dupLead.Phone);
                            phoneLead.is_delete__c = true;
                            leadsToDelete.add(phoneLead);
                        }
                        if(dupLead.Email != null && leadByEmailMap.containsKey(dupLead.Email) && leadByEmailMap.get(dupLead.Email).Lead_Type__c == 'Direct'){
                            Lead emailLead = leadByEmailMap.get(dupLead.Email);
                            emailLead.is_delete__c = true;
                            
                            if (!leadsToDelete.contains(emailLead)) {
                                leadsToDelete.add(emailLead);
                            }
                        }
                    }
                    else if(dupLead.CreatedDate.date().daysBetween(System.today()) <= 60){
                        system.debug('second condition');
                        if(dupLead.Phone != null && leadByPhoneMap.containsKey(dupLead.Phone)){
                            leadByPhoneMap.get(dupLead.Phone).addError('Duplicate Lead created within 60 days found with same Phone Number.');
                        }
                        if(dupLead.Email != null && leadByEmailMap.containsKey(dupLead.Email)){
                            leadByEmailMap.get(dupLead.Email).addError('Duplicate Lead created within 60 days found with same Email.');
                        }
                        // if(dupLead.Alternate_Phone__c != null && leadByPhoneMap.containsKey(dupLead.Alternate_Phone__c)){
                        //     leadByPhoneMap.get(dupLead.Alternate_Phone__c).addError('Duplicate Lead created within 60 days found with same Phone Number.');
                        // }
                        // if(dupLead.Alternate_Email__c != null && leadByEmailMap.containsKey(dupLead.Alternate_Email__c)){
                        //     leadByEmailMap.get(dupLead.Alternate_Email__c).addError('Duplicate Lead created within 60 days found with same Email.');
                        // }
                    }else{
                        system.debug('else default condition');
                    }
                }
            }
            if(!leadstoUpdate.isEmpty()){
                System.debug('leadstoUpdatebeforeUpdate: ' + leadstoUpdate);
                update leadstoUpdate;
            }
        }catch(Exception e){
            System.debug('Error at line: ' + e.getLineNumber() + ' ' + e.getMessage());
        }
    }
    
    public static void validationsAfterStatusChange(List<Lead> newLeads, Map<Id, Lead> oldMap) {
        system.debug('validationsAfterStatusChange method called...');
        system.debug('newLeads ====> '+newLeads);
        // if(!newLeads.isEmpty()){
        //     return;
        // }
        for (Lead lead : newLeads) {
            if(lead.By_Pass_Validations__c == false){
                system.debug('By Pass False...');
                Lead oldLead = oldMap.get(lead.Id);
                List<String> errorMessages = new List<String>();
                
                // Ensure we are only checking when the Status changes
                if(lead.Status !=null && oldLead.Status !=null &&  oldLead.Status != lead.Status){
                    if (oldLead.Status == 'New') {
                        if (lead.Status == 'Assigned') {
                            if (!lead.Is_User_Assigned__c) {
                                lead.Is_User_Assigned__c.addError('Is User Assigned must be true when status is Assigned.');
                            }
                        }
                        
                        else if (lead.Status == 'Contacted' ) {
                            if (!lead.Is_User_Assigned__c) {
                                lead.Is_User_Assigned__c.addError('Is User Assigned must be true when status is Assigned.');
                            }
                            else if (!(lead.Email_Conversation_Done__c || lead.Phone_Conversation_Done__c)) {
                                errorMessages.add('Either Email or Phone conversation must be done.');
                            }
                            // else if (lead.Next_Follow_Up_Date_Time__c == null || lead.Next_Follow_Up_Date_Time__c <= System.now()) {
                            //     lead.Next_Follow_Up_Date_Time__c.addError('Next Follow Up Date Time must be a future date.');
                            // }
                        }
                        
                        else if (lead.Status == 'Qualified') {
                            if (!lead.Is_User_Assigned__c) {
                                lead.Is_User_Assigned__c.addError('Is User Assigned must be true when status is Assigned.');
                            }
                            else if (!(lead.Email_Conversation_Done__c || lead.Phone_Conversation_Done__c)) {
                                errorMessages.add('Either Email or Phone conversation must be done.');
                            }
                            // else if (!lead.Is_Qualified__c) {
                            //     lead.Is_Qualified__c.addError('Is Qualified must be true.');
                            // }
                            // else if (lead.Qualification_Criteria__c == null) {
                            //     lead.Qualification_Criteria__c.addError('Please add Qualification Critieria.');
                            // }
                        }
                        
                        else if (lead.Status == 'SV Planned') {
                            if (!lead.Is_User_Assigned__c) {
                                lead.Is_User_Assigned__c.addError('Is User Assigned must be true when status is Assigned.');
                            }
                            else if (!(lead.Email_Conversation_Done__c || lead.Phone_Conversation_Done__c)) {
                                errorMessages.add('Either Email or Phone conversation must be done.');
                            }
                            else if(lead.Next_Follow_Up_Date_Time__c == null || lead.Next_Follow_Up_Date_Time__c <= System.now()) {
