    public  void assignToQueue(List<Lead> newLeads) {
        try {
            System.debug('New Leads: ' + newLeads);
            if (newLeads == null || newLeads.isEmpty()) {
                return;
            }
            
            Group leadQueue = [SELECT Id, DeveloperName, Name FROM Group WHERE DeveloperName = 'Lead_Assignment_Queue' LIMIT 1];
            
            for (Lead lead : newLeads) {
                System.debug('lead ==> ' + lead);
		lead.OwnerId = leadQueue.Id;                
                
                if (lead.Status == 'New' 
                    && !lead.Is_User_Assigned__c 
                    && !lead.By_Pass_Validations__c && lead.External_Lead__c) {
                        lead.OwnerId = leadQueue.Id;
                        System.debug('Assigned Lead ' + lead.Id + ' to queue: ' + leadQueue.Name);
                        
                    } else if(!lead.By_Pass_Validations__c) {
                       // lead.Is_User_Assigned__c = true;
                        lead.Lead_Type__c = 'Direct';
                       // lead.Pre_Sales_Team_Member__c = UserInfo.getUserId();
                        System.debug('Skipped Lead ' + lead.Id + ' due to unmet conditions');
                    } else{
                       // lead.Is_User_Assigned__c = true;
                    }
                
            }
        } catch (Exception e) {
            System.debug('Error in assignToQueue: ' + e.getMessage() + ' at line: ' + e.getLineNumber());
        }
    }
    
    
