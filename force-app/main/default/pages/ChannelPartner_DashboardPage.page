                                <h5 class="card-title">Approved Invoices Not Found</h5>
                                <p class="card-text">No Aproved Invoices is available. Please contact support for further assistance.</p>
                            </div>
                        </div>

                        <div ng-if = "paginatedApprovedInvoices.length > 0" class="row mobile-cards1">
                            <div class="col-12" ng-repeat="invoice in paginatedApprovedInvoices">
                                <div class="card">
                                    <div class="card-body">
                                        <p>CP Id: <strong>{{invoice.Channel_Partner__r.Channel_Partner_Id__c}}</strong></p>
                                        <p>CP Name: <strong>{{invoice.Channel_Partner__r.Name}}</strong></p>
                                        <p>Project Name: <strong>{{invoice.Project__r.Name}}</strong></p>
                                        <p>Unit Name: <strong>{{invoice.Unit__r.Unit_Name__c}}</strong></p>
