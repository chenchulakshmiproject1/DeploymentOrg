            .no-payment-card .card-body {
                display: flex;
                flex-direction: column;
                align-items: center;
            }
 
            .no-payment-card .card-title {
                color: #ff0000;
                font-size: 18px;
                font-weight: bold;
                margin-bottom: 10px;
            }
 
            .no-payment-card .card-text {
                color: #333;
                font-size: 14px;
            }
