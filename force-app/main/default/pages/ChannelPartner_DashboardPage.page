                <div ng-show = "allInvoicesPage">
                    <div class="container-fluid">
                        <span class="mb-4 back-link"><p class="bi bi-arrow-left" ng-click="showMainPage()">&nbsp;&nbsp;&nbsp;Back</p></span>
                        <div ng-if = "paginatedAllInvoices.length > 0" class="table-responsive1">
                            <table class="table">
                                <thead class="table-header-custom">
                                    <tr>
                                        <th scope="col">Sr.</th>
                                        <th scope="col">CP ID</th>
                                        <th scope="col">CP Name</th>
                                        <th scope="col">Project Name</th>
                                        <th scope="col">Unit Name</th>
                                        <th scope="col">Invoice No.</th>
                                        <th scope="col">Invoice Submission Date</th>
                                        <th scope="col">Transaction Details</th>
                                        <th scope="col">Status</th>
                                    </tr>
                                </thead>
                                <tbody style="border:none;">
                                    <div>
                                    <tr ng-repeat = "invoice in paginatedAllInvoices">
                                        <td>{{$index+1}}</td>
                                        <td>{{invoice.Channel_Partner__r.Channel_Partner_Id__c}}</td>
                                        <td>{{invoice.Channel_Partner__r.Name}}</td>
                                        <td>{{invoice.Project__r.Name}}</td>
                                        <td>{{invoice.Unit__r.Unit_Name__c}}</td>
                                        <td>{{invoice.Name}}</td>
                                        <td>{{invoice.CreatedDate}}</td>
                                        <td><button class="btn1" ng-click="openPreview(invoice)"><i class="bi bi-eye"></i></button></td>
                                        <td><span class="approval-status {{statusClassMapping[invoice.Approval_Status__c]}}">{{invoice.Approval_Status__c}}</span></td>
                                    </tr>
                                </div>
                                </tbody>
                            </table>
                        </div>

                        <div ng-if="paginatedAllInvoices.length == 0" class="no-payment-card">
                            <div class="card-body">
                                <h5 class="card-title">Invoices Not Found</h5>
                                <p class="card-text">No Invoices is available. Please contact support for further assistance.</p>
                            </div>
                        </div>
             
                       
                        <div ng-if = "paginatedAllInvoices.length > 0" class="row mobile-cards1">
                            <div class="col-12" ng-repeat="invoice in paginatedAllInvoices">
                                <div class="card">
                                    <div class="card-body">
                                        <p>CP Id: <strong>{{invoice.Channel_Partner__r.Channel_Partner_Id__c}}</strong></p>
                                        <p>CP Name: <strong>{{invoice.Channel_Partner__r.Name}}</strong></p>
                                        <p>Project Name: <strong>{{invoice.Project__r.Name}}</strong></p>
                                        <p>Unit Name: <strong>{{invoice.Unit__r.Unit_Name__c}}</strong></p>
                                        <p>Invoice No.: <strong>{{invoice.Name}}</strong></p>
                                        <p>Invoice Submission Date: <strong>{{invoice.CreatedDate}}</strong></p>
                                        <p>Transaction Details: <button class="btn1" ng-click="openPreview(invoice)"><i class="bi bi-eye"></i></button></p>
                                        <p>Status: <strong>{{invoice.Approval_Status__c}}</strong></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Pagination -->
                        <div  ng-if = "paginatedAllInvoices.length > 0" class="d-flex justify-content-between align-items-center mt-4">
                            <div>
                                <span>Showing {{getDisplayedRange()}} of {{totalAllInvoicePages}} entries</span>
                            </div>
                            <nav>
                                <ul class="pagination">
                                    <li class="page-item" ng-class="{disabled: currentAllInvoicePage == 1}">
                                        <a class="page-link" href="" ng-click="prevPages()">
                                            <i class="bi bi-arrow-left"></i> Prev
                                        </a>
                                    </li>
                                    <!-- Dynamically displayed page numbers -->
                                    <li class="page-item" ng-repeat="page in getPageRange()" ng-class="{active: currentAllInvoicePage == page}">
                                        <a class="page-link" href="" ng-click="goToPage(page)">
                                            {{page}}
                                        </a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: currentAllInvoicePage == totalAllInvoicePages}">
                                        <a class="page-link" href="" ng-click="nextPages()">
                                            Next <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>

                


                <div ng-show = "invoiceAmountApprovedPage">
                    <div class="container-fluid">
                        <span class="mb-4 back-link"><p class="bi bi-arrow-left" ng-click="showMainPage()">&nbsp;&nbsp;&nbsp;Back</p></span>
