                                        <p>Invoice Submission Date: <strong>{{invoice.CreatedDate}}</strong></p>
                                        <p>Transaction Details: <button class="btn1" ng-click="openPreview(invoice)"><i class="bi bi-eye"></i></button></p>
                                        <p>Status: <strong>{{invoice.Approval_Status__c}}</strong></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Pagination -->
                        <div ng-if = "paginatedApprovedInvoices.length > 0" class="d-flex justify-content-between align-items-center mt-4">
                            <div>
                                <span>Showing {{getDisplayedRange()}} of {{totalApprovedInvoicePages}} entries</span>
                            </div>
                            <nav>
                                <ul class="pagination">
                                    <li class="page-item" ng-class="{disabled: currentApprovedInvoicePage == 1}">
                                        <a class="page-link" href="" ng-click="prevPages()">
                                            <i class="bi bi-arrow-left"></i> Prev
                                        </a>
                                    </li>
                                    <!-- Dynamically displayed page numbers -->
                                    <li class="page-item" ng-repeat="page in getPageRange()" ng-class="{active: currentApprovedInvoicePage == page}">
                                        <a class="page-link" href="" ng-click="goToPage(page)">
                                            {{page}}
                                        </a>
                                    </li>
                                    <li class="page-item" ng-class="{disabled: currentApprovedInvoicePage == totalApprovedInvoicePages}">
                                        <a class="page-link" href="" ng-click="nextPages()">
                                            Next <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
