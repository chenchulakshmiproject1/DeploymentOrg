                    } */

                    .dashboard-card-titel {
                        font-size: 24px !important;
                        font-weight: bold;
                    }

                    .row {
                        margin: 0 !important; /* Remove any extra margin from the row */
                    }

                    .btn {
                        background-color: #4CAF50; /* Optional styling for buttons */
                        color: white;
                        border: none;
                        padding: 10px 20px;
                        border-radius: 5px;
                        cursor: pointer;
                    }

                    .btn:hover {
                        background-color: #45a049;
                    }

/* Responsive adjustments */
@media (max-width: 768px) {
