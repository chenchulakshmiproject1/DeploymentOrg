            }
            .stage-Approved{
                background-color: #28a745;
                color: white;
            }
            .stage-Rejected{
                background-color: #ff0000;
                color: white;
            }
            .approval-status {
                text-align: center;
                width: 100px;
                font-size: 12px;
                font-weight: 600;
                padding: 5px 10px;
                border-radius: 20px;
