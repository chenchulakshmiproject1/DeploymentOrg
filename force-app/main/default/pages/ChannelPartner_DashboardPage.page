                                        <td><span class="approval-status {{statusClassMapping[invoice.Approval_Status__c]}}">{{invoice.Approval_Status__c}}</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div ng-if="paginatedApprovedInvoices.length == 0" class="no-payment-card">
