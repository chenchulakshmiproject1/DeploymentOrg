<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0">
    <html>
        <div ng-controller="customerdoc_ctrl">
            <head>
                <!-- Include Bootstrap CSS -->
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
                <!-- Include Font Awesome -->
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous"/>
                <!-- Include Bootstrap Icons -->
                <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous"/>
                
                <style>
                    html, body {
                        margin: 0;
                        padding: 0;
                        overflow-x: hidden; /* Prevent horizontal scroll */
                    }
                    .container-fluid {
                        padding-left: 0; /* Remove left padding */
                        padding-right: 0; /* Remove right padding */
                    }
                    .title-color {
                        color: #1F1E1E !important;
                    }
                    .accordion-button {
                        background-color: #A3A3A3 !important;
                        color: white !important;
                        border-radius: 8px !important;
                        font-weight: 500 !important;
                    }
                    .accordion-button:not(.collapsed) {
                        background-color: #A3A3A3 !important;
                        color: white !important;
                    }
                    .accordion-button::after {
                        filter: invert(1) !important; /* Change the color of the arrow to white */
                    }
                    .accordion-body {
                        background-color: transparent !important;
                        border-radius: 10px !important;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important; /* Add box-shadow */
                    }
                    .accordion-item {
                        margin-bottom: 10px !important; /* Add gap between accordion items */
                        border: none !important; /* Remove the border */
                        background-color: transparent !important;
                    }
                    .nested-accordion .accordion-button {
                        background-color: #f1f1f1 !important;
                        color: #232323 !important;
                        border: 1px solid #d1d1d1 !important;
                    }
                    .nested-accordion .accordion-button:not(.collapsed) {
                        background-color: #e2e2e2 !important;
                        color: #232323 !important;
                    }

                    /* Mobile adjustments */
                    @media (max-width: 576px) {
                        .container-fluid {
                            width: 107% !important; /* Set width to 104% */
                            padding-left: 0; /* Remove left padding */
                            padding-right: 0; /* Remove right padding */
                            margin-left: -2%; /* Adjust margin to counter overflow */
                            margin-right: -2%; /* Adjust margin to counter overflow */
                            box-sizing: border-box; /* Include padding in width calculation */
                        }
                    }

                    /* iPad adjustments */
                    @media (min-width: 577px) and (max-width: 1024px) {
                        .container-fluid {
                            width: 103% !important; /* Set width to 100% */
                            margin-left: auto; /* Center the content */
                            margin-right: auto; /* Center the content */
                            max-width: 900px; /* Optional: Limit the maximum width */
                            padding-left: 15px; /* Optional: Add some padding */
                            padding-right: 15px; /* Optional: Add some padding */
                        }
                    }
                </style>                         
            </head>
            
            <body>
                <div class="container-fluid">
                    <div ng-show="mainPage">
                        <h2 class="title-color mb-4">Customer Documents</h2>
                        <p>Access and manage your customer documents with SNN Estates below. Stay informed on contracts, agreements, and customer records securely. Our platform ensures easy navigation and secure document handling. For any questions or additional assistance, please don't hesitate to contact our support team.</p>
                        <div ng-if = "opportunities.length > 0" class="table-responsive1">
                            <table class="table">
                                <thead class="table-header-custom">
                                    <tr>
                                        <th scope="col">Sr.</th>
                                        <th scope="col">Opportunity Name</th>
                                        <th scope="col">Unit</th>
                                        <th scope="col">Tower</th>
                                        <th scope="col">Project</th>
                                        <th scope="col">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat = "opp in opportunities" style="border:none;">
                                        <td>{{$index+1}}</td>
                                        <td>{{opp.Name}}</td>
                                        <td>{{opp.Unit__r.Unit_Name__c}}</td>
                                        <td>{{opp.Tower__c}}</td>
                                        <td>{{opp.Project__r.Name}}</td>
                                        <td>
                                            <div class="action-buttons">
                                                <button class="schedule-visit-button" ng-click="showApplicants(opp)">View Applicants</button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                         
                                                <div ng-if="opportunities.length == 0" class="no-payment-card">
                            <div class="card-body">
                                <h5 class="card-title">Customer Documents Not Found</h5>
                                <p class="card-text">No Customer Documents are available. Please contact support for further assistance.</p>
                            </div>
                        </div>
                                                
                        <div ng-if = "opportunities.length > 0" class="row mobile-cards1">
                            <div class="col-12" ng-repeat="opp in opportunities">
                                <div class="card">
                                    <div class="card-body">
                                        <p><strong>Opportunity Name: </strong>{{opp.Name}}</p>
                                        <p><strong>Unit: </strong>{{opp.Unit__r.Unit_Name__c}}</p>
                                        <p><strong>Tower: </strong>{{opp.Tower__c}}</p>
                                        <p><strong>Project: </strong>{{opp.Project__r.Name}}</p>
                                        <p>
                                            <div class="action-buttons">
                                                <button class="schedule-visit-button" ng-click="showApplicants(opp)">View Applicants</button>
                                            </div>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div ng-show="applicantsPage">
                        <span class="mb-4 back-link"><p class="bi bi-arrow-left" ng-click="showMainPage()">&nbsp;&nbsp;&nbsp;Back</p></span>
                        <div class="accordion" id="appAccordian">
                            <div class="accordion-item" ng-repeat="app in applicants">
                                <h2 class="accordion-header" id="app-{{ $index }}">
                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseApp-{{ $index }}" aria-expanded="false" aria-controls="collapseApp-{{ $index }}" ng-click="getApplicantDocuments(app.Account__c)">
                                        {{app.Account__r.Name}}
                                    </button>
                                </h2>
                                <div id="collapseApp-{{ $index }}" class="accordion-collapse collapse" aria-labelledby="headingApp-{{ $index }}" data-bs-parent="#appAccordian">
                                    <div class="accordion-body">
                                        <div class="accordion nested-accordion" id="docAccordian-{{ $index }}">
                                            <div class="accordion-item" ng-repeat="doc in docs">
                                                <h2 class="accordion-header" id="doc-{{ $parent.$index }}-{{ $index }}">
                                                    <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseDoc-{{ $parent.$index }}-{{ $index }}" aria-expanded="false" aria-controls="collapseDoc-{{ $parent.$index }}-{{ $index }}">
                                                        {{doc.Name}}
                                                    </button>
                                                </h2>  
                                                <div id="collapseDoc-{{ $parent.$index }}-{{ $index }}" class="accordion-collapse collapse" aria-labelledby="headingDoc-{{ $parent.$index }}-{{ $index }}" data-bs-parent="#docAccordian-{{ $parent.$index }}">
                                                    <div class="accordion-body" style="background-color:#fafafa !important;">
                                                        <div class="d-flex flex-row justify-content-between mb-3" ng-repeat="subDoc in doc.Sub_Documents__r">
                                                            <p>{{subDoc.Name}}</p>
                                                            <button class="btn btn-danger btn-sm" ng-click="openPreview(subDoc.File_URL__c)"><i class="fa fa-eye"></i></button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="filePreviewModalCustDocs" tabindex="-1" role="dialog" aria-labelledby="filePreviewModalCustDocsLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title text-center w-100" id="filePreviewModalCustDocsLabel">File Preview</h5>
                                        <button type="button" class="close" data-dismiss="modal" ng-click="closeModal()" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <iframe id="filePreviewFrameCustDocs" style="width: 100%; height: 500px;" frameborder="0"></iframe>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-click="closeModal()">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </div>
    </html>
</apex:page>