<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0" controller="ChannelPartner_Controller">
    <html>
        <div ng-controller="cppprojectspage_ctrl">
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <apex:includeScript value="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js" />
                <apex:includeScript value="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" />
                <apex:stylesheet value="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
                <style>
                    .title-color {
                        color: #0B1E35;
                    }
                    .project-card {
                        flex: 1 0 calc(100% - 20px); /* Full width on mobile by default */
                        max-width: calc(100% - 20px); /* Ensures it does not overflow */
                        margin: 10px; /* Add margin for spacing */
                        border-radius: 15px;
                        overflow: hidden;
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
                        transition: transform 0.3s ease;
                    }
                                
                    .carousel-inner .img1 {
                        border-radius: 15px 15px 0 0;
                        width: 100%;
                        height: 200px;
                        object-fit: cover;
                    }

                    .carousel-inner .img2 {
                        border-radius: 15px 15px 0 0;
                        width: 100%;
                        height: 400px;
                        object-fit: cover;
                    }
            
                    .project-info {
                        padding: 15px;
                        height:110px;
                    }
            
                    .project-title {
                        font-weight: 600;
                        color: #0B1E35;
                        margin-bottom: 5px;
                        display: inline-block;
                    }
            
                    .share-icon {
                        background-color: rgba(255, 255, 255, 0.8);
                        color: #666666;
                        font-size: 18px;
                        float: right;
                        margin-top: -5px;
                        cursor: pointer;
                    }
            
                    .project-address {
                        font-size: 14px;
                        color: #666666;
                        margin-bottom: 10px;
                    }
            
                    .view-details-btn {
                        background-color: #9D6200;
                        color: white;
                        font-weight: 600;
                        border-radius: 5px;
                        padding: 10px;
                        width: 100%;
                        text-align: center;
                        display: block;
                        text-decoration: none;
                        cursor: pointer;
                    }
            
                    .container-fluid {
                        /* padding: 30px; */
                    }
            
                    .hidden-content {
                        display: none;
                    }
                    .property-details-container {
                        background-color: #fff;
                        border-radius: 10px;
                        box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.1);
                        padding: 20px;
                        margin-top: 20px;
                    }
                    .btn-custom-p {
                        background-color: #9D6200 !important;
                        color: white !important;
                        border-radius: 8px !important;
                        border: none !important;
                        padding: 10px 20px !important;
                        font-weight: 500 !important;
                        transition: background-color 0.3s ease !important;
                        width: 90% !important;
                        margin-bottom: 10px !important;
                    } 
                    .btn-custom-p-outline {
                        background-color: transparent;
                        color: #9D6200;
                        border: 1px solid #9D6200;
                        border-radius: 8px;
                        padding: 10px 20px;
                        font-weight: 500;
                        transition: background-color 0.3s ease, color 0.3s ease;
                    }
                    .btn-custom-p:hover, .btn-custom-p-outline:hover {
                        background-color: #c0392b;
                        color: white;
                    }
                    .property-details-table {
                        width: 100%;
                        margin-top: 20px;
                        border-collapse: collapse;
                    }
                    .property-details-table th, .property-details-table td {
                        text-align: center;
                        vertical-align: middle;
                        border: 1px solid #dee2e6;
                        padding: 10px;
                    }
                    .table th, .table td{
                        font-size: 1em !important;
                    }
                    .carousel-indicators button {
                        border-color: #9D6200;
                    }
                    .carousel-indicators .active {
                        background-color: #9D6200;
                    }
                    .amenities-container {
                        margin-top: 20px;
                        display: flex;
                        flex-wrap: wrap;
                        justify-content: space-between;
                    }
                    .amenity-item {
                        display: flex;
                        align-items: center;
                        margin-right: 20px;
                        margin-bottom: 10px;
                    }
                    .amenity-item i {
                        font-size: 20px;
                        margin-right: 5px;
                        color: #0B1E35;
                    }
                    .listing-details {
                        margin-bottom: 15px;
                        border: 1px solid #dee2e6;
                        border-radius: 10px;
                        overflow: hidden;
                    }
                    .listing-details .table {
                        margin-bottom: 0;
                    }
                    .listing-details .table td {
                        border: 1px solid #dee2e6;
                        padding: 8px;
                    }
                    .listing-details .table td strong {
                        display: block;
                    }
                    .back-link {
                        font-size: 24px; 
                        text-decoration: none;
                        display: flex;
                        align-items: center;
                        color: black; 
                        font-weight: 500;
                    }
                    .back-link i {
                        cursor: pointer;
                        margin-right: 8px;
                    }
                    .loadingSection {
                        position: fixed;
                        top: 0;
                        left: 0;
                        width: 100%;
                        height: 100%;
                        z-index: 9999;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }

                    .loadingBackground {
                        position: absolute;
                        width: 100%;
                        height: 100%;
                        background-color: rgba(0, 0, 0, 0.5); /* Dark semi-transparent background */
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }

                    .loadingWrapper {
                        position: relative;
                        z-index: 10000; /* Ensures the loader is above the background */
                    }
                    .loader {
                        width: 48px;
                        height: 48px;
                        border: 5px solid #FFF;
                        border-bottom-color: transparent;
                        border-radius: 50%;
                        display: inline-block;
                        box-sizing: border-box;
                        animation: rotation 1s linear infinite;
                    }

                    .row {
                            display: flex; /* Use flexbox to arrange items in a row */
                            flex-wrap: wrap; /* Allow wrapping to the next line */
                            margin: -10px; /* Adjust margin to compensate for padding */
                        }

                    @keyframes rotation {
                        0% {
                            transform: rotate(0deg);
                        }
                        100% {
                            transform: rotate(360deg);
                        }
                    }


                   /* For tablets (768px to 1024px) */
                    @media (min-width: 768px) and (max-width: 1024px) {
                        .project-card {
                            flex: 1 0 calc(46% - 20px); /* Two cards per row with margin */
                            max-width: calc(46% - 20px); /* Keep cards at a maximum width */
                        }

                        /* Adjust the layout for specific numbers of cards */
                        /* If there are 5 cards, make sure the last two fit correctly */
                        .project-card:nth-last-child(2) {
                            flex: 1 0 calc(46% - 20px); /* Last second card */
                            max-width: calc(46% - 20px);
                        }

                        .project-card:nth-last-child(1) {
                            flex: 1 0 calc(50% - 20px); /* Last card should also be 46% width */
                            max-width: calc(50%); 
                        }
                    }

                    /* For larger screens (1024px and above) */
                @media (min-width: 1025px) {
                   
                    .project-card {
                        flex: 1 0 calc(33.333% - 20px); /* Three cards per row */
                        max-width: calc(33.333% - 20px);
                        margin: 10px; /* Add margin for spacing */
                    }

                    /* Handle the last two cards for 5 total cards */
                    .project-card:nth-last-child(2),
                    .project-card:nth-last-child(1) {
                        flex: 1 0 calc(33.33% - 20px); /* Set to 46% for last two cards */
                        max-width: calc(33.33% - 20px); 
                    }
                }

              

                    @media(max-width: 1080px){
                        

                        .row {
                            display: flex; /* Use flexbox to arrange items in a row */
                            flex-wrap: wrap; /* Allow wrapping to the next line */
                            margin: 0px; /* Adjust margin to compensate for padding */
                        }

                        .col-md-4 {
                            flex: 0 1 100%; /* Set to 100% width for two cards per row, minus margin */
                            margin: 5px; /* Add margin around each card */
                        }

                        
                            
                        

                        .carousel-item {
                            display: flex; /* Center the images */
                            justify-content: center; /* Center the images */
                        }

                        .carousel-inner .img1 {
                            height: 150px; /* Adjust image height for better layout */
                        }

                        .noImg {
                            height: 150px !important; /* Adjust height for no image */
                        }

                        .project-details {
                            flex-direction: column; /* Stack items vertically on mobile */
                            align-items: flex-start; /* Align items to the left */
                        }

                        .share-icon {
                            margin-bottom: 5px; /* Add some space below the share icon */
                        }

                        .text-primary {
                            /* Change the font size or styling for the map link on mobile if needed */
                            font-size: 14px; /* Example: adjust font size */
                        }

                        .amenity-item {
                            flex: 1 1 100%; /* On mobile screens, items take full width */
                            margin: 5px 0; /* Adjusts vertical spacing between items */
                        }
                    }
                    .noImg{
                        height: 200px;
                    }
                    .scrollable-cards {
                        display: flex; /* Use flexbox for layout */
                        overflow-x: auto; /* Enable horizontal scrolling for mobile */
                        max-width: 100%; /* Ensure it takes full width */
                        margin-top: 20px; /* Add some spacing above */
                        padding: 10px; /* Optional: padding inside the scrollable area */
                        scroll-snap-type: x mandatory; /* Snap scrolling */
                    }
                    .noImg1 {
                        height: 150px;
                    }
                    @media (max-width: 768px) {
                        .scrollable-cards {
                            flex-direction: row; /* Horizontal alignment for mobile */
                        }
                    }
                    @media (min-width: 769px) {
                        .scrollable-cards {
                            flex-direction: column; /* Stack vertically on larger screens */
                            overflow: visible; /* Remove scrolling on larger screens */
                        }
                    }
                </style>
                <script src="https://unpkg.com/swiper/swiper-bundle.min.js"></script>
            </head>

            <body>
                <div ng-show = "mainPage">
                    <div id="projectmainpageContent" class="container-fluid">
                        <!-- Header Section -->
                        <div class="mb-4">
                            <h2 class="title-color">Projects</h2>
                            <p class="section-subtitle">
                                Explore our exclusive project listings tailored for our channel partners. You can access detailed information on each project. Stay informed and provide your clients with the best options using the comprehensive resources provided by SNN Estates Empower your business with the latest updates and exclusive insights into our diverse range of properties.
                            </p>
                        </div>
                
                        <!-- Projects Grid -->
                        <div class="row rowLP d-none d-md-flex">
                            <div class="project-card" ng-repeat="project in projects">
                                <div id="carouselExampleControl{{ $index }}" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <div ng-if="project.Sub_Documents__r != undefined" ng-repeat="imageUrl in project.Sub_Documents__r" class="carousel-item" ng-class="{active: $first}">
                                            <img src="{{imageUrl.File_URL__c}}" class="img1 d-block w-100" alt="{{project.Name}}"/>
                                        </div>
                                        <div ng-if="project.Sub_Documents__r == undefined">
                                            <div class="noImg"></div>
                                        </div>
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControl{{ $index }}" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControl{{ $index }}" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                </div>
                                <div class="project-info">
                                    <h5 class="project-title">{{project.Name}}</h5>
                                    <p class="project-address">{{project.Project_Address__c}}</p>
                                </div>
                                <div class="d-flex justify-content-center">
                                    <button type="button" class="btn btn-custom-p" ng-click="showProjectDetails(project)">View Details</button>
                                </div>
                            </div>
                        </div>
                        <div class="d-md-none scrollable-cards" >
                            <div class="project-card" ng-repeat="project in projects">
                                <div id="carouselExampleControl{{ $index }}" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <div ng-if="project.Sub_Documents__r != undefined" ng-repeat="imageUrl in project.Sub_Documents__r" class="carousel-item" ng-class="{active: $first}">
                                            <img src="{{imageUrl.File_URL__c}}" class="img1 d-block w-100" alt="{{project.Name}}"/>
                                        </div>
                                        <div ng-if="project.Sub_Documents__r == undefined">
                                            <div class="noImg1"></div>
                                        </div>
                                    </div>
                                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControl{{ $index }}" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Previous</span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControl{{ $index }}" data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                        <span class="visually-hidden">Next</span>
                                    </button>
                                </div>
                                <div class="project-info">
                                    <h5 class="project-title">{{project.Name}}</h5>
                                    <p class="project-address">{{project.Project_Address__c}}</p>
                                </div>
                                <div style="margin-top:auto;" class="d-flex justify-content-center">
                                    <button type="button" class="btn btn-custom-p" ng-click="showProjectDetails(project)">View Details</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="loadingSection" ng-show="showSpinner">
                    <div class="loadingBackground">
                        <div class="loadingWrapper">
                            <div class="loader"></div>
                        </div>
                    </div>
                </div>

                <div ng-show = "detailsPage">
                    <div id="projectDetailsMainContent" class="container-fluid">
                        <span class="mb-4 back-link"><p class="bi bi-arrow-left icon1" ng-click="showMainPage()"></p></span>
                        <!-- Image Carousel -->
                        <div id="propertyCarousel" class="carousel slide mt-3" data-bs-ride="carousel">
                            
                            <div class="carousel-inner">
                                <div ng-repeat="imageUrl in projectDetails.Sub_Documents__r" class="carousel-item" ng-class="{active: $first}">
                                    <img ng-src="{{imageUrl.File_URL__c}}" class="img2 d-block w-100" alt="{{projectDetails.Name}}"/>
                                </div>
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Previous</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Next</span>
                            </button>
                        </div>
                        <div class="project-details d-flex flex-column flex-md-row justify-content-between align-items-center mt-4">
                            <h5 class="mb-0">{{projectDetails.Project_Address__c}}</h5>
                        </div>
                
                        <!-- Property Details -->
                        <div class="mt-4">
                            <div class="listing-details">
                                <table class="table">
                                    <tr>
                                        <td><strong>{{projectDetails.Project_Type__c}}</strong><br/>Type</td>
                                        <td><strong>{{projectDetails.Unit_Type__c}}</strong><br/>Unit Type</td>
                                        <td><strong>{{projectDetails.Project_Status__c}}</strong><br/>Project Status</td>
                                    </tr>
                                    <tr>
                                        <td><strong>{{projectDetails.Total_Amount__c}}</strong><br/>Total Amount</td>
                                        <td><strong>{{projectDetails.Booking_Amount__c}}</strong><br/>Booking Amount</td>
                                        <td><strong>{{projectDetails.Area__c}}</strong><br/>Area</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                
                        <!-- Amenities -->
                        <div ng-if="projectDetails.Amenities__r" class="mt-4">
                            <h5>Amenities</h5>
                            <div class="amenities-container">
                                <div class="amenity-item" ng-repeat="amenity in projectDetails.Amenities__r">
                                    <i class="fas fa-{{amenity.Icon_Name__c}}"></i> <span>{{amenity.Name}}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </div>
    </html>
    
</apex:page>