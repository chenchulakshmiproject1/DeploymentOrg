<apex:page sidebar="false" showHeader="false" standardStylesheets="false" controller="siteVisitFormController">
    <html>
        <head>
            <apex:stylesheet value="{!$Resource.BookingFormCSS}" />
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.1.6/semantic.css"/>
            <c:Libraries ></c:Libraries>
            <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.6.9/angular.min.js"></script>
            <!-- <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>  -->
            <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800&display=swap" rel="stylesheet" />
            <link href="https://use.fontawesome.com/releases/v5.15.1/css/all.css" rel="stylesheet"/>
            
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.4/jquery.js"/>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/angular.js/1.4.8/angular.js"/>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/semantic-ui/2.1.6/semantic.js">
            </script>
            <style>
                .createVisit{
                    color: blue !important;
                    text-decoration: underline !important;
                }
                a:hover{
                    cursor: pointer;
                }
            </style>
        </head>
        <body ng-app="visit_app" ng-controller="visit_ctrl" style="overflow-x: hidden;">
            <div class="booking-form3">
                <div class="container mb-5">
                    <!-- <h5 class="heading text-center"><b>SITE VISIT FORM</b></h5> -->
                    <div class="row mt-3">
                        <div class="col-md-5">
                            <label class="label">Enter Email or Phone</label>
                            <input type="text" class="form-control mt-2" ng-model="searchValue" />
                        </div>
                        <div class="col-md-7 mt-4">
                            <button class="button" ng-click="getleadDet()">Search</button>
                            <button class="button" ng-show="errorMsg" ng-click="createLead()"><i class="fa fa-plus"></i>  Create New Lead</button> 
                            <button class="button" ng-show="showLeadDetails || showVisitAfterCreatn" id="btnSubmit1" ng-click="OnClickcreateVisit()">Create Visit</button>
                            <button class="button" id="btnPleaseWait1" style="text-align: center; display:none;"><i class="fa-solid fa-spinner fa-spin-pulse me-3"></i>Please Wait....</button>
                        </div>
                    </div>
                    <div class="row mt-5" ng-show="errorMsg">
                        <h3 style="color: red; text-align:center;">No such record available ! Try Again.....</h3>
                    </div>
                    <div class="row mt-5" ng-show="showLeadDetails">
                        <hr class="border" />
                        <h5 style="color:#1e45aa;"><b>Lead Details</b></h5>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Name</label>
                            <input type="text" class="form-control" ng-model="leadDetails.FirstName" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Surname</label>
                            <input type="text" class="form-control" ng-model="leadDetails.LastName" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Email ID</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Email" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Phone No.</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Phone" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Pre Sales Team Member</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Pre_Sales_Team_Member__r.Name" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Channel Partner</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Channel_Partner__r.Name" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Lead Stage</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Status" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Lead Source</label>
                            <input type="text" class="form-control" ng-model="leadDetails.LeadSource" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Lead Sub Source</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Lead_Sub_Source__c" ng-disabled="true" />
                        </div>
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Lead Type</label>
                            <input type="text" class="form-control" ng-model="leadDetails.Lead_Type__c" ng-disabled="true" />
                        </div>
                        
                        <div class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Bypass Validation</label>
                            <input type="checkbox" class="form-check-input" id="bypassValidation" ng-model="leadDetails.By_Pass_Validations__c" />
                        </div>
						

                    </div>
                    <div class="row mt-5" ng-show="showAllLeadDetails">
                        <hr class="border" />
                        <div ng-if="leadList.length>1">
                            <h5 style="color:#1e45aa;"><b>All Lead Details</b></h5>
                            <div class="table-responsive table-res">
                                <table class="table">
                                    <thead class="table-header-custom">
                                        <tr>
                                            <th scope="col">Sr.</th>
                                            <th scope="col">Name</th>
                                            <th scope="col">Surname</th>
                                            <th scope="col">Email</th>
                                            <th scope="col">Phone</th>
                                            <th scope="col">Pre Sales Team Member</th>
                                            <th scope="col">Lead Source</th>
                                            <th scope="col">Lead Sub Source</th>
                                            <th scope="col">Lead Type</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody style="border:none">
                                        <tr ng-repeat = "lead in leadList">
                                            <td>{{$index + 1}}</td>
                                            <td>{{lead.FirstName}}</td>
                                            <td>{{lead.LastName}}</td>
                                            <td>{{lead.Email}}</td>
                                            <td>{{lead.Phone}}</td>
                                            <td>{{lead.Pre_Sales_Team_Member__r.Name}}</td>
                                            <td>{{lead.LeadSource}}</td>
                                            <td>{{lead.Lead_Sub_Source__c}}</td>
                                            <td>{{lead.Lead_Type__c}}</td>
                                            <td><a class="createVisit" ng-click="OnClickcreateVisit(lead)">Create Visit</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-5" ng-show="showAllOppDetails">
                        <div ng-if="oppList.length>0">
                            <h5 style="color:#1e45aa;"><b>All Opportunity Details</b></h5>
                            <div class="table-responsive table-res">
                                <table class="table">
                                    <thead class="table-header-custom">
                                        <tr>
                                            <th scope="col">Sr.</th>
                                            <th scope="col">Name</th>
                                            <th scope="col">Email</th>
                                            <th scope="col">Phone</th>
                                            <th scope="col">Lead Source</th>
                                            <th scope="col">Lead Sub Source</th>
                                            <th scope="col">Lead Type</th>
                                            <th scope="col">Pre Sales Team Member</th>
                                            <th scope="col">No. of Visits</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody style="border:none">
                                        <tr ng-repeat = "opp in oppList">
                                            <td>{{$index + 1}}</td>
                                            <td>{{opp.Name}}</td>
                                            <td>{{opp.Email__c}}</td>
                                            <td>{{opp.Phone__c}}</td>
                                            <td>{{opp.LeadSource}}</td>
                                            <td>{{opp.Lead_Sub_Source__c}}</td>
                                            <td>{{opp.Lead_Type__c}}</td>
                                            <td>{{opp.Pre_Sales_Team_Member__r.Name}}</td>
                                            <td><a ng-click="showRelVisits(opp)">{{oppXvisitMap[opp.Id] ? oppXvisitMap[opp.Id].length : 0}}</a></td>
                                            <td><a class="createVisit" ng-click="OnClickcreateVisit(opp)">Create Visit</a></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div ng-show="relVisits">
                                <h5 style="color:#1e45aa;"><b>All Visits related to {{opp.Name}} opportunity</b></h5>
                                <div class="table-responsive table-res">
                                    <table class="table">
                                        <thead class="table-header-custom">
                                            <tr>
                                                <th scope="col">Sr.</th>
                                                <th scope="col">Visit Id</th>
                                                <th scope="col">Opportunity</th>
                                                <th scope="col">Project Name</th>
                                            </tr>
                                        </thead>
                                        <tbody style="border:none">
                                            <tr ng-repeat = "visit in oppXvisitMap[opp.Id]">
                                                <td>{{$index + 1}}</td>
                                                <td>{{visit.Name}}</td>
                                                <td>{{visit.Opportunity__r.Name}}</td>
                                                <td>{{visit.Project_Name__c}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div ng-show="showCreateLead">
                        <hr class="border" />
                        <div class="row mt-5">
                            <h6 style="color:#1e45aa;"><b>Create New Lead</b></h6>
                            <div class="col-md-6 mt-3">
                                <label class="label pe-3 text-nowrap">Name</label>
                                <input type="text" class="form-control" ng-model="leadDetails.FirstName" />
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="label pe-3 text-nowrap">Surname<span class="required-asterisk" style="color:red;">*</span></label>
                                <input type="text" class="form-control" ng-model="leadDetails.LastName" />
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="label pe-3 text-nowrap">Email ID</label>
                                <input type="text" class="form-control" id="txtEmail" ng-focus="removeClass('txtEmail')" ng-model="leadDetails.Email" />
                            </div>
                            <div class="col-md-6 mt-3">
                                <label class="label pe-3 text-nowrap">Phone No.<span class="required-asterisk" style="color:red;">*</span></label>
                                <input type="text" class="form-control" ng-model="leadDetails.Phone" />
                            </div>

                            <div class="col-md-6 mt-3">
                                <label class="label">Project<span class="required-asterisk" style="color:red;">*</span></label><br/>
                                <so-dropdown class="col-md-12" ng-model="leadDetails.Project__c" dropdown-items="projectList">
                                    <option value='None'>None</option>
                                </so-dropdown>
                            </div>
<div class="col-md-6 mt-3">
    <label class="label pe-3 text-nowrap">Lead Type</label>
    <select class="form-select"
            ng-model="leadDetails.Lead_Type__c"
            ng-options="opt.value as opt.label for opt in leadType"
            ng-change="updateDependentFields()">
        <option value="">-- Select Lead Type --</option>
    </select>
</div>
                            <div class="col-md-6 mt-3" ng-if = "leadDetails.Lead_Type__c == 'Direct'">
                                <label class="label pe-3 text-nowrap">Lead Source</label>
                                <select class="form-select" ng-model = "leadDetails.LeadSource" ng-change="changeOfSource()">
                                    <option ng-repeat="source in leadSources" ng-selected="true">{{source.key}}</option>
                                </select>
                            </div>
                            <div class="col-md-6 mt-3" ng-if = "leadDetails.Lead_Type__c == 'Direct'">
                                <label class="label pe-3 text-nowrap">Lead Sub Source</label>
                                <select class="form-select" ng-model="leadDetails.Lead_Sub_Source__c" ng-disabled = "leadSubSource.length === 0">
                                    <option ng-repeat="subSource in leadSubSource" ng-selected="true">{{subSource}}</option>
                                </select>
                            </div>
                            <div class="col-md-6 mt-3" ng-if = "leadDetails.Lead_Type__c == 'Channel Partner'">
                                <label class="label">Channel Partner</label><br/>
                                <so-dropdown class="col-md-12" ng-model="leadDetails.Channel_Partner__c" dropdown-items="cpList">
                                    <option value='None'>None</option>
                                </so-dropdown>
                            </div>
                            <div class="col-md-6 mt-3" ng-if = "leadDetails.Lead_Type__c == 'Referral'">
                                <label class="label pe-3 text-nowrap">Referral Name</label>
                                <input type="text" class="form-control" ng-model="leadDetails.Referred_By_Name__c" />
                            </div>
                            <div class="col-md-6 mt-3" ng-if = "leadDetails.Lead_Type__c == 'Referral'">
                                <label class="label pe-3 text-nowrap">Referral Phone</label>
                                <input type="text" class="form-control" ng-model="leadDetails.Referred_By_Phone__c" />
                            </div>
                                                        <div  class="col-md-6 mt-3">
                            <label class="label pe-3 text-nowrap">Bypass Validation</label>
                            <input type="checkbox" class="form-check-input" id="bypassValidation" ng-model="leadDetails.By_Pass_Validations__c" />
                        </div>
                        </div>
                        <div class="row mt-5">
                            <!-- <div class="d-grid gap-2">
                                <button class="btn btn-success btn-block" id="btnSubmit" ng-click="saveContact()" type="submit">Submit</button>
                            </div> -->
                            <div class="col-md-12">
                                <button class="button" id="btnSubmit" style="text-align: center;" ng-click="createLeadRecord()">Create</button>
                                <button class="button" id="btnPleaseWait" style="text-align: center; display:none;"><i class="fa fa-spinner" aria-hidden="true"></i> Please Wait....</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="booking-form" ng-if="showVisitSection">
                <div class="container mb-5">
                    <!-- <h5 class="heading text-center"><b>SITE VISIT FORM</b></h5> -->
                    <div class="row justify-content-between">
                        <div class="col-md-3">
                            <!-- <div class="d-flex align-items-center">
                                <label class="label pe-3 text-nowrap">Form No.</label>
                                <input type="text" class="form-control" ng-model="visit.Form_No__c"/>
                            </div> -->
                        </div>
                        <div class="col-md-3">
                            
                        </div>
                        <div class="col-md-3">
                            <div class="d-flex align-items-center">
                                <label class="label pe-3 text-nowrap">Date of visit:</label>
                                <input type="date" class="form-control" placeholder="DD/MM/YYYY" ng-model="today" ng-disabled="true"/>
                            </div>
                        </div>
                    </div>
                    <div class="form-tabs">
                        <div class="sidebar col-md-auto">
                            <ul>
                                <li class="active">
                                    <a ng-click="">Customer Details &amp; <br/>Requirements</a>
