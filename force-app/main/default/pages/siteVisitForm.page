                                    <a ng-click="">To be filled by GRE</a>
                                </li> -->
                                <!-- <li>
                                    <a ng-click="">To be filled by Sales Manager</a>
                                </li> -->
                            </ul>
                        </div>
                        <div class="rightbar">
                            <div class="row">
                                <div class="col-md-12">
                                    <div ng-if="leadDetails.Phone || leadDetails.Email">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Name:<span class="required-asterisk" style="color:red;">*</span></label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="tel" class="form-control" ng-model="leadDetails.FirstName"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Surname:<span class="required-asterisk" style="color:red;">*</span></label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" ng-model="leadDetails.LastName"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Mobile No.:<span class="required-asterisk" style="color:red;">*</span></label>
