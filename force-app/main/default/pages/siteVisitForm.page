                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" ng-model="visit.City__c" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="row align-items-center mb-4">
                                                <div class="col-md-4">
                                                    <label class="label">Pincode:</label>
                                                </div>
                                                <div class="col-md-8">
                                                    <input class="form-control" type="number" ng-model="visit.Pincode__c"/>
