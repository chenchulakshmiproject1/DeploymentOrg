                                        <div class="col-md-10">
                                            <div class="row">
                                                <div class="col-md-4 pt-3" ng-repeat="value in ageGroup">
                                                    <input type="radio" ng-model="visit.Age_Group__c" ng-value="value" ng-change="changeOfAgeGroup(value)" />
                                                    <label>{{value}}</label>
