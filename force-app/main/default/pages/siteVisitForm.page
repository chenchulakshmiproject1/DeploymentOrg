                                                    <select class="form-control" aria-label="Default select example" ng-model="visit.Location__c">
                                                        <option ng-repeat="location in listOfLocation">{{location.Name}}</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div> -->
