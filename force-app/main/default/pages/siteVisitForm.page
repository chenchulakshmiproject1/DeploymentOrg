                                                        <label class="label">Email:</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="email" class="form-control" ng-model="leadDetails.Email"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div ng-if="opp.Name != undefined">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Name:<span class="required-asterisk" style="color:red;">*</span></label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" ng-model="opp.Name"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Surname:<span class="required-asterisk" style="color:red;">*</span></label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="text" class="form-control" ng-model="opp.Name"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Mobile No.:<span class="required-asterisk" style="color:red;">*</span></label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="tel" class="form-control" ng-model="opp.Phone__c"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="row align-items-center mb-4">
                                                    <div class="col-md-4">
                                                        <label class="label">Email:</label>
                                                    </div>
                                                    <div class="col-md-8">
                                                        <input type="email" class="form-control" ng-model="opp.Email__c"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="row align-items-center mb-4">
                                                <div class="col-md-4">
                                                    <!--label class="label">Date of Birth:</label><span class="required-asterisk" style="color:red;">*</span-->
                                                    <label class="label">Date of Birth:</label>
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="date" class="form-control" ng-model="visit.Date_Of_Birth__c"/>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="row align-items-center mb-4">
                                                <div class="col-md-4">
                                                    <label class="label">Alternate Phone:</label>
                                                </div>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" ng-model="visit.Alternate_Phone__c" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
