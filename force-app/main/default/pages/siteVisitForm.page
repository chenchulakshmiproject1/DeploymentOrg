                $scope.validateEmail = function (value) {
                    if (value != undefined && value != '')   {
                        var x = value;
                        var atpos = x.indexOf("@");
                        var dotpos = x.lastIndexOf(".");
                        if (atpos < 1 || dotpos < atpos + 2 || dotpos + 2 >= x.length) {
                            return true;
                        }
                        return false;
                    }
                }

