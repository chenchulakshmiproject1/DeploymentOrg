                                        <div class="col-md-10">
                                            <textarea class="form-control" ng-model="visit.Residential_Address__c"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="row align-items-center mb-4">
                                                <div class="col-md-4">
                                                    <label class="label">Residence City:</label>
