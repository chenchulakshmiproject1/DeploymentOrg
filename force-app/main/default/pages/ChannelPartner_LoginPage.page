            $scope.submitApproval = function(){
                return new Promise(function (resolve, reject) {
                    debugger;
                    if($scope.newAcc.Name == undefined || $scope.newAcc.Name == ''){
                        swal(
                            'Info',
                            'Please Enter Channel Partner Name as per RERA!',
                            'info'
                            );
                        return reject('Please Enter Channel Partner Name as per RERA!');
                    }
                    if($scope.newAcc.RERA_Number__c == undefined || $scope.newAcc.RERA_Number__c == ''){
                        swal(
                            'Info',
                            'Please Enter RERA Registration Number!',
                            'info'
                            );
                        return reject('Please Enter RERA Registration Number!');
                    }
                    if($scope.newAcc.PAN__c == undefined || $scope.newAcc.PAN__c == ''){
                        swal(
                            'Info',
                            'Please Enter Channel Partner PAN Number!',
                            'info'
                            );
                        return reject('Please Enter Channel Partner PAN Number!');
                    }
                    if($scope.newAcc.RERA_Certificate_Expiry_Date__c == undefined || $scope.newAcc.RERA_Certificate_Expiry_Date__c == ''){
                        swal(
                            'Info',
                            'Please Enter Channel Partner RERA Certificate Expiry!',
                            'info'
                            );
                        return reject('Please Enter Channel Partner RERA Certificate Expiry!');
                    }
                    // if($scope.newAcc.Bank_Account_Type__c == undefined || $scope.newAcc.Bank_Account_Type__c == ''){
                    //     swal(
                    //         'Info',
