                        if(typeOfFile[lengthOfType - 1] != 'pdf' && typeOfFile[lengthOfType - 1] != 'jpeg' && typeOfFile[lengthOfType - 1] != 'jpg' && typeOfFile[lengthOfType - 1] != 'png'){
                            swal('info', 'Please choose pdf/jpg/jpeg/png Cancelled Cheque file only.', 'info');
                            return reject('Invalid file format');
                        }
                    }

                    if ($scope.newAcc.RERA_Certificate_Expiry_Date__c != undefined && $scope.newAcc.RERA_Certificate_Expiry_Date__c != '') {
                        const dateString = $scope.newAcc.RERA_Certificate_Expiry_Date__c;
                        // Create a new Date object from the date string
                        const dateObject = new Date(dateString);
                        // Get the Unix timestamp (milliseconds since the Unix epoch)
                        const unixTimestamp = dateObject.getTime();
                        // Update the $scope.SLIlist[i].Actual_date_of_dispatch__c with the Unix timestamp
                        $scope.newAcc.RERA_Certificate_Expiry_Date__c = unixTimestamp;
                    }
                    $scope.showSpinner = true;
                    // $("#loadButton").show();
                    // $("#submitApproval").hide();
                    // console.log(JSON.stringify($scope.newAcc));
                    $scope.newAcc.Phone = $scope.phoneNumber;
                    ChannelPartner_Controller.submitAcc($scope.newAcc,function(result,event){
                        debugger;
                        if(event && result.length <= 18){
