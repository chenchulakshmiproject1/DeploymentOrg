    <script>
        var app = angular.module('channelPortalApp', []);
        var companyType = JSON.parse('{!companyType}');
        var msmeValues = JSON.parse('{!msmeValues}');
        var focusAreas = JSON.parse('{!focusAreas}');
        var ProductInterest = JSON.parse('{!ProductInterest}');
        //var BankAccType = JSON.parse('{!BankAccType}');
        var maxStringSize = 6000000; //Maximum String size is 6,000,000 characters

        app.controller('channellogin_ctrl', ['$scope', function($scope) {
            debugger;
            var self = this;
            $scope.companyType = companyType;
            $scope.msmeValues = msmeValues;
            $scope.focusAreas = focusAreas;
            $scope.ProductInterest = ProductInterest;
            //$scope.BankAccType = BankAccType;
            $scope.showLogin = true;
            $scope.showRegister = false;
            $scope.showSpinner = false;
            $scope.phoneNumber = '';
            $scope.otp = ['', '', '', '', '', ''];
            $scope.maskedPhoneNumber = '';
            $scope.errorMessage = '';
            $scope.generatedOTP = '';
            $scope.newAcc = {"Name" : ""};
            $scope.selectedPdtInt = [];
            $scope.selectedFocusArea = [];

            $scope.changeOfCompanyType = function(value){
                debugger;
                $scope.newAcc.Company_Type__c = value;
            }

            // $scope.changeOfBankAccType = function(value){
            //     debugger;
            //     $scope.newAcc.Bank_Account_Type__c = value;
            // }

            $scope.changeOfProductInterest = function(){
                debugger;
                let selected = [];
                for (let option in $scope.selectedPdtInt) {
                    if (option != 'remove' && $scope.selectedPdtInt[option]) {
                        selected.push(option);
                    }
                }
                // Convert the array to a semicolon-separated string
                $scope.newAcc.Product_of_Interest__c = selected.join(';');
                $scope.$apply();
            }

            $scope.changeOfFocusAreas = function(){
                debugger;
                let selected = [];
                for (let option in $scope.selectedFocusArea) {
                    if (option != 'remove' && $scope.selectedFocusArea[option]) {
                        selected.push(option);
                    }
                }
                // Convert the array to a semicolon-separated string
                $scope.newAcc.Focus_Areas__c = selected.join(';');
                $scope.$apply();
            }

            $scope.toggleForm = function(form) {
                debugger;
                $scope.showLogin = false;
                $scope.showRegister = false;

                if (form === 'login') {
                    $scope.showLogin = true;
                    $scope.generatedOTP = '';
                } else if (form === 'register') {
                    $scope.showRegister = true;
                }
            };

            $scope.getOtp = function() {
                debugger;
                const phoneNumber = $scope.phoneNumber;
                $scope.maskedPhoneNumber = `+91 ${phoneNumber.substring(0, 2)}XXXXXX${phoneNumber.substring(8)}`;
                if($scope.phoneNumber.length == 10){
                    $scope.toggleForm('verify');
                    // ChannelPartner_Controller.sendOTP($scope.phoneNumber, function(result, event){
                    //     debugger;
                    //     if(event.status && result){
                    //         if($scope.generatedOTP == ''){
                    //             $scope.generatedOTP = result;
                    //         }else{
                                $scope.generatedOTP = '000000';
                    //             swal('Info', 'OTP has been resent to your phone number!', 'info');
                    //         }
                    //     }
                    // })
                }else {
                    swal('Info', 'Please enter valid phone number!', 'info');
                }
            };

            $scope.verifyOtp = function() {
                debugger;
                // Combine entered OTP values into a single string
                var enteredOtp = $scope.otp.join('');
                // Check if entered OTP matches the expected value
                if (enteredOtp === $scope.generatedOTP) {
                    const phoneNumber = $scope.phoneNumber;
                    $scope.errorMessage = ''; // Clear any previous error messages
                    // Call Apex method via Visualforce remoting
                    ChannelPartner_Controller.checkAccount(phoneNumber, function(result, event) {
                        debugger;
                        if (event.status) {
                            if(result.str == 'Not Channel Partner Account'){
                                swal('Info', 'Not the right page to Log In !', 'info');
                                $scope.showSpinner = false;
                                // $("#loadButton").hide();
                                // $("#submitApproval").show();
