                                })
                                .then(() => $scope.uploadDoc('Cancelled Cheque'))
                                .then(() => $scope.submitAccApproval($scope.accId))
                                .then(() => $scope.verifyOtp())
                                .then(resolve)
                                .catch(reject);
                            }, 1000);
                            resolve(result);
                        }else{
                            console.log('Error creating account');
                            reject('event.result');
                        }
                    });
                    $scope.$apply();
                });
            }

            $scope.uploadDoc = function(type){
                return new Promise(function (resolve, reject) {
                    var file;
                    if(type == 'PAN'){
                        file = document.getElementById("panImage").files[0];
                    }else if(type == 'MSME Certificate'){
                        file = document.getElementById("msmeCerti").files[0];
                    }else if(type == 'RERA Certificate'){
                        file = document.getElementById("rearCerti").files[0];
                    }
                    else if(type == 'Cancelled Cheque'){
                        file = document.getElementById("canCheque").files[0];
                    }
                    fileName = file.name;
                    debugger;
                    attachmentName = file.name;
                    var fileReader = new FileReader();
                    fileReader.onloadend = function (e) {
                        attachment = window.btoa(this.result);  // Base 64 encode the file before sending it
                        positionIndex = 0;
                        fileSize = attachment.length;
                        attachmentBody = attachment.substring(positionIndex);
                        // $scope.showSpinnereditProf = false;
                        debugger;
                        if (fileSize < maxStringSize) {
                            // Call the function to upload the attachment
                            ChannelPartner_Controller.uploadDocuments($scope.accId, attachmentName, attachmentBody, fileSize, type, file.type, function(result, event){
                                debugger;
                                if(event.status && result && result.subDocUrl){
                                    $scope.fileURL = result.subDocUrl;
                                    resolve('Success uploading' + type);
                                }else{
                                    console.log('Error while uploading ' + type + ' ---> ' + JSON.stringify(event));
                                    reject(result);
                                }
                                $scope.$apply();
                            });
                        } else {
                            swal("info", "Base 64 Encoded file is too large. Maximum size is " + maxStringSize + " your file is " + fileSize + ".", "info");
                            return reject('File too large');
                        }
                    };

                    fileReader.onerror = function () {
                        swal("info", "There was an error reading the file. Please try again.", "info");
                        return reject('File reading error');
                    };

                    fileReader.onabort = function () {
                        swal("info", "There was an error reading the file. Please try again.", "info");
                        return reject('File read aborted');
                    };

                    fileReader.readAsBinaryString(file);  // Read the body of the file
                })
            }

            $scope.submitAccApproval = function(value){
                return new Promise(function (resolve, reject) {
                    debugger;
                    ChannelPartner_Controller.submitApproval($scope.accId, function(result, event){
                        if(event.status && result.includes('success')){
                            resolve(result);
                        }else{
                            reject(result);
                        }
                    })
                })
            }
        }]);

        document.addEventListener('DOMContentLoaded', function() {
            const otpInputs = document.querySelectorAll('.otp-input-box');
            
            otpInputs.forEach((input, index) => {
                input.addEventListener('input', () => {
                    if (input.value.length === 1 && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }
                });

                input.addEventListener('keydown', (e) => {
                    if (e.key === 'Backspace' && input.value.length === 0 && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });
            });
        });
