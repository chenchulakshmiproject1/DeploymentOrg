<apex:page controller="ChannelPartner_Controller" showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0">
    
    <!-- Include Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/limonte-sweetalert2/7.29.2/sweetalert2.all.js"></script>
    <!-- Include Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous"/>
    
    <!-- Include AngularJS -->
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/2.1.4/jquery.js"/>
    
    <style>
        .custom-btn {
            background-color: #9D6200 !important;
            color: white !important;
            font-weight: 500 !important;
        }
        
        .bg-image-vertical {
            position: relative;
            overflow: hidden;
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
        }
        
        .otp-inputs {
            gap: 8px;
        }
        .otp-input-box {
            width: 48px;
            height: 48px;
            border: 1px solid #C7C4C4;
            border-radius: 8px;
            text-align: center;
            font-size: 24px;
        }

        /* .left-side-image-container img {
            opacity: 0.85;
        } */
    
        /* Custom styles for labels */
        .form-label {
            font-weight: bold;
            text-align: left;
            display: block;
        }
        
        /* Custom styles for the text below the heading */
        .community-text {
            margin-top: 16px;
            text-align: left;
            margin-bottom: 24px;
        }
        .welcome-message {
            font-size: 28px;
        }

        .text-left{
            text-align: left;
        }

        .mobile-image-container{
            display: none;
        }
        
        @media (min-width: 1024px) {

            .h-custom-2 {
                height: 100%;
            }
    
            .left-side-image-container {
                background-color: #1F1E1E;
                height: 100vh;
                /* display: flex;
                flex-direction: column; */
                align-items: center;
                /* justify-content: flex-end; */
                width: 50%; /* Ensuring the image container takes half */
            }
        }
        
        /* Custom font size for the welcome message on laptop screens */
        @media (min-width: 1024px){
            
            .text-black {
                width: 50%; 
                
            }

            
            .col-md-6 {
                display: flex;               
                justify-content: flex-end;   
                align-items: center;         
            }
        }

        .scrollable-form {
            max-height: 60vh;
            overflow-y: scroll;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
    
        .scrollable-form::-webkit-scrollbar {
            display: none;
        }

        .phoneCon{
            align-items: center;
        }

        .size {
            width: -webkit-fill-available;
            height: -webkit-fill-available;
        }
    
        @media (max-width: 1024px) {
            
            .mobile-image-container {
                display: block !important;
                margin-bottom: 40px;
                background-color: #000;
                text-align: center;
                width: 100%; 
                height: 40vh; 
                overflow: hidden;
            }

            .mobile-image-container img {
                width: 100%;
                height: 100%;
                object-fit: cover; 
            }
            
            .left-side-image-container {
                display: none !important; 
            }

            .container-fluid{
                width: 100%;
            }

            .text-black{
                width: 100%;
                font-size:30px;  
            }
 
        } 

        .logo {
            width: 15rem;
            /* height: 128px; */
            margin-bottom : 5%;
        }
    
        .headerMobile {
            /* margin-left: -60%; */
            font-size: 70px;
        }
        
        .text-dark {
            width: 100%; 
            margin: 0; 
            font-size: 17px;
            font-weight: 400;
            text-align: center;
        }

        .input-group{
            margin-bottom : 20px;
        }

        .phone-number-input {
            height: 48px; 
            padding: 10px; 
            font-size: 16px; 
        }

        .custom-btn{
            height: 48px; 
            padding: 10px 20px; 
            font-size: 16px; 
            border-radius:  20px solid red;
        }

        .otp-input-box {
            width: 70px;
            height: 70px;
            border: 1px solid #C7C4C4;
            border-radius: 8px;
            text-align: center;
            font-size: 24px;
        }

        .MobileV{
            font-size: 30px;
        }

        .fwh{
            font-weight: 600;
            font-size: 28px;
            text-align : left;
            margin : 0px;
        }

        .row2>*{
            flex-shrink: 0;
            max-width: 100%;
            /* padding-right: calc(var(--bs-gutter-x) * .5); */
            margin-top: var(--bs-gutter-y);
        }

        .loadingSection {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .loadingBackground {
            position: absolute;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); /* Dark semi-transparent background */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .loadingWrapper {
            position: relative;
            z-index: 10000; /* Ensures the loader is above the background */
        }
        .loader {
            width: 48px;
            height: 48px;
            border: 5px solid #FFF;
            border-bottom-color: transparent;
            border-radius: 50%;
            display: inline-block;
            box-sizing: border-box;
            animation: rotation 1s linear infinite;
        }

        @keyframes rotation {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
    </style>
    
    
