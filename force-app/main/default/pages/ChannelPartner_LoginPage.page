                                                    <div class="d-flex flex-wrap">
                                                        <div class="row2" style="display:flex;">
                                                            <div class="form-check me-3" ng-repeat="value in BankAccType">
                                                                <input type="radio" ng-model="newAcc.Bank_Account_Type__c" ng-value="value" ng-change="changeOfBankAccType(value)" />
                                                                <label>{{value}}</label>
