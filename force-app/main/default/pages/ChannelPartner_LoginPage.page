                                        // $("#loadButton").hide();
                                        // $("#submitApproval").show();
                                    }else{
                                        localStorage.setItem('teamHead', true);
                                        $scope.showSpinner = false;
                                        // $("#loadButton").hide();
                                        // $("#submitApproval").show();
                                    }
                                    localStorage.setItem('hashCode', $scope.hashCode);
