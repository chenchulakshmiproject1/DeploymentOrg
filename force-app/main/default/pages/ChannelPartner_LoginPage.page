                                    // console.log(value); // Output: 'value'
                                    // $scope.toggleForm('verify');
                                    var currentdate = new Date();
                                    localStorage.setItem('LogIn Time', currentdate);
                                    swal('Success', 'Login successful!', 'success');
                                    // Determine the site prefix depending on the URL
                                    var sitePrefix = window.location.href.includes('/apex') ? '/apex' : '/ChannelPartnerPortal';
                                    // Debugging output to check variables
                                    // console.log("sitePrefix:", sitePrefix);
                                    // console.log("Log In Hash Code:", $scope.hashCode);
                                    // Check if Log In Hash Code is valid
                                    if (!$scope.hashCode) {
                                        console.error('Error: Log In Hash Code is not defined');
                                        return;
                                    }
                                    // Construct the new URL
                                    var newUrl = window.location.origin + sitePrefix + '/ChannelPartner_SidebarPage?id=' + $scope.hashCode + '#/ChannelPartner_DashboardPage';
                                    // console.log("Redirecting to:", newUrl);
                                    window.location.href = newUrl;
                                }
                            }
                        } else {
                            // Show error message if there's a remoting error
                            $scope.errorMessage = 'Error occurred while verifying account.';
                            $scope.showSpinner = false;
                            // $("#loadButton").hide();
                            // $("#submitApproval").show();
                        }
                        $scope.$apply(); // Apply scope changes
                    });
                }else {
                    swal('Error', 'Please enter correct OTP!', 'error');
                }
                    // var currentdate = new Date();
                    // localStorage.setItem('LogIn Time', currentdate);
                    // alert('Login successful!');
                    // // Determine the site prefix depending on the URL
