                    //         'info'
                    //         );
                    //     return reject('Please Enter Bank Name!');
                    // }
                    // if($scope.newAcc.Bank_Account_Number__c == undefined || $scope.newAcc.Bank_Account_Number__c == ''){
                    //     swal(
                    //         'Info',
                    //         'Please Enter Bank Account Number!',
                    //         'info'
                    //         );
                    //     return reject('Please Enter Bank Account Number!');
                    // }
                    // if($scope.newAcc.Branch_Name__c == undefined || $scope.newAcc.Branch_Name__c == ''){
                    //     swal(
                    //         'Info',
                    //         'Please Enter Branch Name!',
                    //         'info'
                    //         );
                    //     return reject('Please Enter Branch Name!');
                    // }
                    // if($scope.newAcc.IFSC_Code__c == undefined || $scope.newAcc.IFSC_Code__c == ''){
                    //     swal(
                    //         'Info',
                    //         'Please Enter IFSC Code!',
                    //         'info'
                    //         );
                    //     return reject('Please Enter IFSC Code!');
                    // }
                    if(document.getElementById("panImage").files[0] == undefined){
                        swal(
                            'Info',
                            'Please upload PAN image!',
                            'info'
                            );
                        return reject('Please upload PAN image!');
                    }else {
                        var PANfile = document.getElementById("panImage").files[0];
                        var fileName = PANfile.name;
                        var typeOfFile = fileName.split(".");
                        var lengthOfType = typeOfFile.length;
                        if (PANfile.size > '3000000') {
                            swal("info", "PAN file must be under 3 mb in size. Your file is too large. Please try again.", "info");
                            return reject('PAN File too large');
                        }
                        if(typeOfFile[lengthOfType - 1] != 'pdf' && typeOfFile[lengthOfType - 1] != 'jpeg' && typeOfFile[lengthOfType - 1] != 'jpg' && typeOfFile[lengthOfType - 1] != 'png'){
                            swal('info', 'Please choose pdf/jpg/jpeg/png PAN file only.', 'info');
                            return reject('Invalid file format');
                        }
                    }
                    // if(document.getElementById("msmeCerti").files[0] == undefined){
                    //     swal(
                    //         'Info',
                    //         'Please upload MSME Certificate!',
                    //         'info'
                    //         );
                    //     return reject('Please upload MSME Certificate!');
                    // }
                    // else {
                    var MSMEfile = document.getElementById("msmeCerti").files[0];
                    if (MSMEfile) {
                        var fileName = MSMEfile.name;
                        var typeOfFile = fileName.split(".");
                        var lengthOfType = typeOfFile.length;
                        var fileExtension = typeOfFile[lengthOfType - 1].toLowerCase();
                        if (MSMEfile.size > '3000000') {
                            swal("info", "MSME File must be under 3 mb in size. Your file is too large. Please try again.", "info");
                            return reject('MSME File too large');
                        }
                        if (['pdf', 'jpeg', 'jpg', 'png'].indexOf(fileExtension) === -1) {
                            swal('Info', 'Please choose a PDF, JPG, JPEG, or PNG MSME file only.', 'info');
                            return reject('Invalid MSME file format');
                        }
                    }
                    if(document.getElementById("rearCerti").files[0] == undefined){
                        swal(
                            'Info',
                            'Please upload RERA Certificate!',
                            'info'
                            );
                        return reject('Please upload RERA Certificate!');
                    }else {
                        var RERAfile = document.getElementById("rearCerti").files[0];
                        var fileName = RERAfile.name;
                        var typeOfFile = fileName.split(".");
                        var lengthOfType = typeOfFile.length;
                        if (RERAfile.size > '3000000') {
                            swal("info", "RERA File must be under 3 mb in size. Your file is too large. Please try again.", "info");
                            return reject('RERA File too large');
                        }
                        if(typeOfFile[lengthOfType - 1] != 'pdf' && typeOfFile[lengthOfType - 1] != 'jpeg' && typeOfFile[lengthOfType - 1] != 'jpg' && typeOfFile[lengthOfType - 1] != 'png'){
                            swal('info', 'Please choose pdf/jpg/jpeg/png RERA file only.', 'info');
                            return reject('Invalid file format');
                        }
                    }
                    if(document.getElementById("canCheque").files[0] == undefined){
                        swal(
                            'Info',
                            'Please upload Cancelled Cheque!',
                            'info'
                            );
                        return reject('Please upload Cancelled Cheque!');
                    }else {
                        var RERAfile = document.getElementById("canCheque").files[0];
                        var fileName = RERAfile.name;
                        var typeOfFile = fileName.split(".");
                        var lengthOfType = typeOfFile.length;
                        if (RERAfile.size > '3000000') {
                            swal("info", "Cancelled Cheque must be under 3 mb in size. Your file is too large. Please try again.", "info");
                            return reject('Cancelled Cheque too large');
