                                // $("#submitApproval").show();
                            } else {
                                // Account exists, proceed to OTP verification
                                if(result.acc.Approval_Status__c && result.acc.Approval_Status__c == 'Pending'){
                                    var sitePrefix1 = window.location.href.includes('/apex') ? '/apex' : '/ChannelPartnerPortal';
                                    var underApprovalUrl = window.location.origin + sitePrefix1 + '/ChannelPartner_ApprovalPage';
                                    window.location.href = underApprovalUrl;
                                }else{
