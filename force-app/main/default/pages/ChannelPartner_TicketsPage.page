<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0" controller="ChannelPartner_Controller">
    <html>
        <div ng-controller="cppticket_ctrl">
            <head>
                <!-- Include Bootstrap CSS -->
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous"/>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
                <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.2/angular.min.js"></script>
                <!-- Include Font Awesome -->
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.2/css/all.min.css" rel="stylesheet" crossorigin="anonymous"/>
        
                <!-- Include Bootstrap Icons -->
                <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.8.1/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous"/>
                <script>
                    var typeValue = JSON.parse('{!caseType}');
                </script>
            </head>
        
            <style>
                .title-color {
                    color: #0B1E35 !important;
                    font-weight: 600 !important;
                    font-size: 32px !important;
                }
                .ticket-content{
                    font-size: 16px;
                    font-weight: 400;
                }
                .btn-custom {
                    background-color: #9D6200 !important;
                    color: white !important;
                    border-radius: 8px !important;
                    border: none !important;
                    width: auto !important; /* Adjust to the natural width */
                    padding: 10px 20px !important;
                }
                .btn-custom:hover {
                    background-color: #724906 !important;
                }
                .btn-outline-secondary {
                    border-radius: 8px !important;
                    border: 1px solid #0B1E35 !important; /* Custom border color */
                    width: auto !important; /* Adjust to the natural width */
                    padding: 8px 24px !important;
                    color: #0B1E35 !important;
                }
                .btn-outline-secondary:hover {
                    background-color: #f8f9fa !important;
                    color: #0B1E35 !important;
                }
                .modal-title-color {
                    color: var(--Black, #232323) !important;
                    font-size: 25px !important;
                    font-weight: 600 !important;
                }
                .modal-header {
                    border-bottom: none !important;
                }
                .modal-footer {
                    border-top: none !important;
                    justify-content: center !important;
                    gap: 10px !important;
                }
                .modal-backdrop {
                    background-color: rgba(0, 0, 0, 0.5) !important; /* Lighter background */
                }
                .input-group-text {
                    background-color: #f8f9fa !important;
                }
                .form-label-ticket {
                    font-weight: bold !important; /* Make the Mobile Number label bold */
                    font-size: 16px !important;
                }
                .center-container {
                    display: flex !important;
                    justify-content: center !important;
                    align-items: center !important;
                    height: calc(100vh - 150px) !important; /* Adjust the height of the container to cover the viewport minus some margin */
                }
            
                .button-container {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 8px;
                    margin-top: 15px;
                }
                .contact-sales-button, .schedule-visit-button, .btn-custom-alt{
                    flex: 1;
                    height: 40px;
                    padding: 10px 18px;
                    border-radius: 8px;
                    font-size: 14px;
                    font-family: Hind, sans-serif;
                    font-weight: 500;
                    line-height: 20px;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    text-align: center;
                }
                .contact-sales-button {
                    border: 1px solid #0B1E35;
                    color: #0B1E35;
                    background-color: white;
                }
                .schedule-visit-button {
                    background: #9D6200;
                    color: white;
                    border: none;
                }
                .text-muted {
                    font-size: 20px;
                }
                .btn-container {
                    text-align: center;
                }
                .ticket-description{
                    font-weight: 400;
                    font-size: 15px;
                }
                .form-label-ticket{
                    font-weight: 600 !important;
                }
            </style>
        
            <body>
                <div>
                    <div class="container-fluid">
                        <div class="d-flex flex-column align-items-start">
                            <h2 class="title-color">Service Requests</h2>
                            <p class="ticket-content">Manage your service requests with SNN Estates by viewing or raising them below. Stay informed on your inquiries, access details of ongoing support issues, and respond promptly to updates. Our team is dedicated to providing you with effective support. For any questions or additional assistance, please don't hesitate to contact our support team.</p>
                            
                            <!-- Button aligned to the left for all screens -->
                            <button type="button" class="btn-custom mt-2" data-bs-toggle="modal" ng-click="openServiceRequestModal()">Raise a Service Request</button>
                        </div>
                    
                        <!-- Removed the mt-3 class from this container -->
                        <div ng-if = "cases.size() == 0" class="d-flex flex-column justify-content-center align-items-center">
                            <img src="{!URLFOR($Resource.noReferrals)}" class="img-fluid" alt="No Service Request Raised"/>
                            <p class="mt-1 text-muted">No Service Request Raised</p> <!-- Adjusted margin for text -->
                        </div>
                        <div ng-if = "cases.size() != 0">
                            <div ng-if = "paginatedTickets.length > 0" class="table-responsive1">
                                <table class="table">
                                    <thead class="table-header-custom">
                                        <tr>
                                            <th scope="col">Sr.</th>
                                            <th scope="col">Subject</th>
                                            <th scope="col">Email</th>
                                            <th scope="col">Phone</th>
                                            <th scope="col">Issue</th>
                                            <th scope="col">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody style="border:none;">
                                        <tr ng-repeat = "case in paginatedTickets">
                                            <td>{{$index+1}}</td>
                                            <td>{{case.Subject}}</td>
                                            <td>{{case.SuppliedEmail}}</td>
                                            <td>{{case.SuppliedPhone}}</td>
                                            <td>{{case.Type}}</td>
                                            <td>{{case.Description}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div ng-if="paginatedTickets.length == 0" class="no-payment-card">
                                <div class="card-body">
                                    <h5 class="card-title">Cases Not Found</h5>
                                    <p class="card-text">No Cases are available. Please contact support for further assistance.</p>
                                </div>
                            </div>

                            <div ng-if = "paginatedTickets.length > 0" class="row mobile-cards1">
                                <div class="col-12" ng-repeat="case in paginatedTickets">
                                    <div class="card">
                                        <div class="card-body">
                                            <p>Subject: <strong>{{case.Subject}}</strong></p>
                                            <p>Email: <strong>{{case.SuppliedEmail}}</strong></p>
                                            <p>Phone: <strong>{{case.SuppliedPhone}}</strong></p>
                                            <p>Issue: <strong>{{case.Type}}</strong></p>
                                            <p>Description: <strong>{{case.Description}}</strong></p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- Pagination -->
                            <div ng-if = "paginatedTickets.length > 0" class="d-flex justify-content-between align-items-center mt-4">
                                <div>
                                    <span>Showing {{getDisplayedRange()}} of {{totalTicketItems}} entries</span>
                                </div>
                                <nav>
                                    <ul class="pagination">
                                        <li class="page-item" ng-class="{disabled: curTicketPage == 1}">
                                            <a class="page-link" href="" ng-click="prevPages()">
                                                <i class="bi bi-arrow-left"></i> Prev
                                            </a>
                                        </li>
                                        <!-- Dynamically displayed page numbers -->
                                        <li class="page-item" ng-repeat="page in getPageRange()" ng-class="{active: curTicketPage == page}">
                                            <a class="page-link" href="" ng-click="goToPage(page)">
                                                {{page}}
                                            </a>
                                        </li>
                                        <li class="page-item" ng-class="{disabled: curTicketPage == totalTicketPages}">
                                            <a class="page-link" href="" ng-click="nextPages()">
                                                Next <i class="bi bi-arrow-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="serviceRequestModal" tabindex="-1" aria-labelledby="serviceRequestModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title modal-title-color" id="serviceRequestModalLabel">Raise a Service Request</h5>
                                    <button type="button" class="btn-close" ng-click="closeModal()" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <div style="text-align:left">
                                        <div class="mb-3">
                                            <p class="ticket-description">Please select the type of issue that best matches your inquiry or request below. Our team is dedicated to addressing your needs promptly and efficiently. Thank you for choosing SNN Estates! Your satisfaction is our priority.</p>
                                            <div class="mb-3">
                                                <label for="subject" class="form-label-ticket">Subject</label>
                                                <input type="text" class="form-control" id="subject" placeholder="Write an Subject" ng-model="caseData.Subject"  ng-disabled="false"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="Email" class="form-label-ticket">Email</label>
                                                <input type="text" class="form-control" id="Email" placeholder="abc@xyz.com" ng-model="caseData.SuppliedEmail"  ng-disabled="false"/>
                                            </div>
                                            <div class="mb-3">
                                                <label for="Phone" class="form-label-ticket">Phone</label>
                                                <input type="text" class="form-control" id="Phone" placeholder="+91 94XXXXXX78" ng-model="caseData.SuppliedPhone"  ng-disabled="false"/>
                                            </div>
                                            <label for="issueSelect" class="form-label-ticket">Select an issue</label>
                                            <!-- <select class="form-select" style="width:150;" id="issueSelect">
                                                <option selected="selected">Select an issue you have faced</option>
                                                <option >Issue 1</option>
                                                <option value="2">Issue 2</option>
                                                <option value="Others">Others</option>
                                            </select> -->
                                            <div class="form-group mb-3">
                                                <label class="form-label" for="ticketPDF">Upload Document(if any)</label>
                                                <input type="file" id="ticketPDF" class="form-control"/>
                                            </div>
                                            <select id="issueSelect" style="width:-webkit-fill-available" class="form-select" ng-model="caseData.Type">
                                                <option ng-repeat="value in typeValue" ng-selected="true">{{value}}</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="issueDescription" class="form-label-ticket">Description</label>
                                            <textarea class="form-control" id="issueDescription" rows="3" placeholder="Describe your issue" ng-model="caseData.Description" ng-disabled="false"></textarea>
                                        </div>
                                    </div>
                                    <div class="btn-container">
                                        <button type="button" class="btn-custom" ng-disabled="isDisabledSubmit" ng-click="submitCase()">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </body>
        </div>
    </html>

</apex:page>