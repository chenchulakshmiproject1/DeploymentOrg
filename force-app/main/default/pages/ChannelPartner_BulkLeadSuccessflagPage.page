<apex:page showHeader="false" standardStylesheets="false" sidebar="false">
    <apex:variable var="modalTitle" value="{!IF(NOT(ISBLANK($CurrentPage.parameters.title)), $CurrentPage.parameters.title, 'Bulk Lead Upload Successful!')}"/>
    <apex:variable var="modalContent" value="{!IF(NOT(ISBLANK($CurrentPage.parameters.content)), $CurrentPage.parameters.content, 'Your leads have been successfully uploaded to the SNN Estates Pvt. Ltd. portal. All entries are now available for review and management. Start engaging with your leads and drive your sales forward.')}"/>
    
    <div class="modal fade" id="bulkLeadUploadSuccessModal" tabindex="-1" aria-labelledby="bulkLeadUploadSuccessLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 866px;">
            <div class="modal-content" style="padding: 20px;">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="{!URLFOR($Resource.successScheduleImage)}" alt="Success Image" class="mb-4" style="width: 25%;"/>
                    <h5 class="modal-title" id="bulkLeadUploadSuccessLabel" style="font-weight: 600; font-size: 20px;">
                        {!modalTitle}
                    </h5>
                    <p class="text-muted">
                        {!modalContent}
                    </p>
                </div>
            </div>
        </div>
    </div>
</apex:page>