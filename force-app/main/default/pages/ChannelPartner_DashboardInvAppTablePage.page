<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0">

    <style>
        .title-color {
            color: #0B1E35;
        }
        .btn-custom {
            background-color: #9D6200;
            color: white;
            border: none;
            font-size: 14px; /* Small size for buttons */
        }
        .btn-custom:hover {
            background-color: #724906;
        }
        .view-more-btn {
            background-color: #ffffff;
            color: #0B1E35;
            border: 1px solid #0B1E35;
            font-size: 14px; /* Small size for buttons */
        }
        .view-more-btn:hover {
            background-color: #f1f1f1;
        }
        .table th, .table td {
            vertical-align: middle;
            font-size: 14px; /* Set font size to 14px */
        }
        .sub-table {
            margin-top: 10px;
            background-color: #f9f9f9;
        }
        .btn-icon {
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 5px;
        }
        .btn-icon.view {
            background-color: #0B1E35;
            color: #fff;
        }
        .btn-icon.download {
            background-color: #9D6200;
            color: #fff;
        }
        .btn-icon.view:hover {
            background-color: #1b2b49;
        }
        .btn-icon.download:hover {
            background-color: #c0392b;
        }
        .table-header-custom {
            background-color: #6886AA;
            color: white;
            border-radius: 10px 10px 0 0; /* Rounded corners for the header */
        }
        .table-header-custom th {
            border-top: none;
            border-left: none;
            border-right: none;
        }
        .table-header-custom th:first-child {
            border-top-left-radius: 10px; /* Round top-left corner */
        }
        .table-header-custom th:last-child {
            border-top-right-radius: 10px; /* Round top-right corner */
        }
        .table-body-gap {
            margin-top: 10px;
        }
        .table-container {
            border-radius: 10px; /* Rounded corners for the entire table */
            overflow: hidden;
            background-color: #fff; /* Background color for better visibility of corners */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Shadow effect for the table */
        }
        .action-buttons {
            display: flex;
            gap: 10px;
        }
    
    .contact-sales-button, .schedule-visit-button {
            flex: 1;
            height: 40px;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-family: Hind, sans-serif;
            font-weight: 500;
            line-height: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        .contact-sales-button {
            border: 1px solid #0B1E35;
            color: #0B1E35;
            background-color: white;
        }
        .schedule-visit-button {
            background: #9D6200;
            color: white;
            border: none;
        }
        @media (max-width: 768px) {
            .action-buttons {
                flex-direction: column;
            }
        }
    </style>

    <div class="container-fluid">
        <div class="table-responsive table-container">
            <table class="table mb-0">
                <thead class="table-header-custom">
                    <tr>
                        <th scope="col">Sr.</th>
                        <th scope="col" style="width: 9%;">Channel Partner ID</th>
                        <th scope="col">Channel partner</th>
                        <th scope="col">Project Name</th>
                        <th scope="col" style="width: 7%;">Total Invoices</th>
                        <th scope="col">Payments Released</th>
                        <th scope="col">Payments Released Date</th>
                        <th scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">1</th>
                        <td>CP001</td>
                        <td>SNN Estates</td>
                        <td>SNN Heights</td>
                        <td>3</td>
                        <td>₹1,20,000</td>
                        <td>04 Aug 2024</td>
                        <td>
                            <div class="action-buttons">
                                <button class="schedule-visit-button" onclick="toggleDetails(this)">View more</button>
                            </div>
                        </td>
                    </tr>
                    <tr class="sub-table" style="display: none;">
                        <td colspan="8">
                            <table class="table mb-0">
                                <tr>
                                    <td>Invoice 1</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-icon view">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon download">
                                            <i class="fa fa-download"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Invoice 2</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-icon view">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon download">
                                            <i class="fa fa-download"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Invoice 3</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-icon view text-end">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-icon download text-end">
                                            <i class="fa fa-download"></i>
                                        </button>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <th scope="row">2</th>
                        <td>CP002</td>
                        <td>SNN Estates</td>
                        <td>SNN Villas</td>
                        <td>6</td>
                        <td>₹1,00,000</td>
                        <td>04 Aug 2024</td>
                        <td>
                            <div class="action-buttons">
                                <button class="schedule-visit-button" onclick="toggleDetails(this)">View more</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    

    <script>
        function toggleDetails(button) {
            const row = button.closest('tr');
            const nextRow = row.nextElementSibling;

            if (nextRow.style.display === 'none' || nextRow.style.display === '') {
                nextRow.style.display = 'table-row';
                button.textContent = 'View less';
            } else {
                nextRow.style.display = 'none';
                button.textContent = 'View more';
            }
        }

      
    </script>
</apex:page>