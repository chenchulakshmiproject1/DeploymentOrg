<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0">

    <style>
        .btn-view {
            background-color: #9D6200;
            color: white;
            border: none;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 16px;
        }
        .btn-view:hover {
            background-color: #c0392b;
        }
        .table th, .table td {
            vertical-align: middle;
            font-size: 14px;
        }
    .table-header-custom th:first-child {
            border-top-left-radius: 10px; /* Round top-left corner */
        }
        .table-header-custom th:last-child {
            border-top-right-radius: 10px; /* Round top-right corner */
        }
        .table-header-custom {
            background-color: #6886AA;
            color: white;
        }
        .modal-header, .modal-footer {
            border: none;
        }
        .modal-footer {
            text-align: center;
        }
        .modal-footer .btn {
            width: 100%;
            background-color: #9D6200;
            color: white;
            border-radius: 5px;
            padding: 10px;
            font-size: 16px;
            font-weight: 600;
        }
        .status-completed {
            background-color: #28a745;
            color: white;
            border-radius: 5px;
            padding: 5px 10px;
        }
    	.status-approved {
            background-color: #28a745;
            color: white;
            border-radius: 20px;
            padding: 5px 10px;
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
        }
        .status-pending {
            background-color: #dc3545;
            color: white;
            border-radius: 20px;
            padding: 5px 10px;
            display: inline-block;
            font-size: 11px;
            font-weight: 600;
        }
        .modal-content {
            border-radius: 10px;
            overflow: hidden;
        }
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 9998;
            display: none; /* Hide by default */
        }
        .modal-overlay.active {
            display: block; /* Show when active */
        }
        .modal-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--Secondary, #0B1E35);
            text-align: center; /* Center the text */
            width: 100%; /* Ensure it takes up the full width of the modal header */
        }
        .body-subContent{
            text-align: center; /* Center-align the paragraph text */
            font-size: 16px;
        }
        .modal-footer {
            display: flex;
            justify-content: center; /* Center the button horizontally */
        }
        .modal-footer .btn {
            background-color: #9D6200;
            color: white;
            border-radius: 5px;
            padding: 10px;
            font-size: 16px;
            font-weight: 600;
            width: 380px; /* Set the width to 380px */
        }
        .back-link {
            font-size: 24px; 
            text-decoration: none;
            display: flex;
            align-items: center;
            color: black; /* Set font color to black */
            font-weight: 500; /* Set font weight to 500 */
        }
        .back-link i {
            margin-right: 8px;
        }
    </style>

