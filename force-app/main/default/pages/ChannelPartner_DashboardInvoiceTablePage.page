        <!-- Transaction Details Modal -->
        <div id="modalOverlay" class="modal-overlay">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Transaction Details</h5>
                        <button type="button" class="btn-close" onclick="closeModal()" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="body-subContent">Easily view all your transaction details with SNN Estates Access a comprehensive summary of your transactions, including dates, amounts, and statuses. Stay informed and manage your financial records efficiently.</div>
                        <div class="row mt-5 p-4">
                            <div class="col-md-6">
                                <p><strong>Transaction ID:</strong> TXN1234567890</p>
                                <p><strong>Amount:</strong> ₹1,50,000</p>
                                <p><strong>Payment Method:</strong> Net Banking</p>
                                <p><strong>Property ID:</strong> PROP0001</p>
