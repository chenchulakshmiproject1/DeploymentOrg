<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0" controller="CustomerPortalController">
   <html>
        <div ng-controller="sitevisit_ctrl">
            <!-- Include Bootstrap CSS -->
            <head>
                <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous"/>
                <script src="https://code.angularjs.org/1.8.2/i18n/angular-locale_en-in.js"></script>
                <script>
                    var purposeOfBuying = JSON.parse('{!purposeOfBuying}');
                </script>
            </head>

            <style>
                /* Custom CSS for Tabs */
                .title-color {
                    color: #0B1E35;
                }
                .nav-tabs {
                    border-bottom: 1px solid #dee2e6 !important;
                    flex-wrap: nowrap !important;
                }
                .nav-tabs .nav-link {
                    border: none !important;
                    color: #000 !important;
                }
                .nav-tabs .nav-link.active {
                    color: #000 !important;
                    border-bottom: 3px solid #dc3545 !important;
                }
                .card {
                    border: none !important;
                    border-radius: 10px !important;
                    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1) !important;
                    margin-bottom: 20px !important;
                }
                .card-body {
                    padding: 15px !important;
                }
                .card-title {
                    font-size: 18px !important;
                    font-weight: bold !important;
                    color: #0B1E35 !important;
                }
                .card-text {
                    font-size: 14px !important;
                    color: #6c757d !important;
                }
                .btn-custom {
                    background-color: #9D6200 !important;
                    color: white !important;
                    border: none !important;
                    font-size: 14px !important;
                    padding: 8px 20px !important;
                    border-radius: 5px !important;
                    margin-right: 5px !important;
                }
                .btn-custom:hover {
                    background-color: #724906 !important;
                }
                .btn-outline-custom {
                    background-color: transparent !important;
                    color: #9D6200 !important;
                    border: 1px solid #9D6200 !important;
                    font-size: 14px !important;
                    padding: 8px 20px !important;
                    border-radius: 5px !important;
                }
                .btn-outline-custom:hover {
                    background-color: #9D6200 !important;
                    color: white !important;
                }
                .carousel-inner .img1 {
                    border-radius: 15px 15px 0 0;
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                }
                .carousel-inner .img1 {
                    height: 150px; /* Adjust image height for better layout */
                }
                .scrollable-cards {
                    display: flex; /* Use flexbox for layout */
                    overflow-x: auto; /* Enable horizontal scrolling for mobile */
                    max-width: 100%; /* Ensure it takes full width */
                    margin-top: 20px; /* Add some spacing above */
                    padding: 10px; /* Optional: padding inside the scrollable area */
                    scroll-snap-type: x mandatory; /* Snap scrolling */
                }
                .visit-card {
                    min-width: 240px !important;
                    min-height: 450px;
                }
                @media (max-width: 768px) {
                    .scrollable-cards {
                        flex-direction: row; /* Horizontal alignment for mobile */
                    }
                }
                @media (min-width: 769px) {
                    .scrollable-cards {
                        flex-direction: column; /* Stack vertically on larger screens */
                        overflow: visible; /* Remove scrolling on larger screens */
                    }
                }
                @media (max-width: 1050px) {
                    #upcomingCard {
                        flex: 0 0 45%;
                        max-width: 45%;
                    }
                    #completedCard {
                        flex: 0 0 45%;
                        max-width: 45%;
                    }
                    #incompleteCard {
                        flex: 0 0 45%;
                        max-width: 45%;
                    }
                }
                @media (max-width: 840px) {
                    #upcomingCard {
                        flex: 0 0 49%;
                        max-width: 50%;
                    }
                    #completedCard {
                        flex: 0 0 49%;
                        max-width: 50%;
                    }
                    #incompleteCard {
                        flex: 0 0 49%;
                        max-width: 50%;
                    }
                }
            </style>
