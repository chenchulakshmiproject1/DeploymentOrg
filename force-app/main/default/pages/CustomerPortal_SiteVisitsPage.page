                                                <p class="card-text"><strong>Agent Name:</strong> {{visit.CreatedBy.Name}}</p>
                                            </div>
                                            <div style="margin-top:auto;" class="button-container">
                                                <button ng-show = "!visit.showContact" class="contact-sales-button" ng-click="showPhone(visit)">Call CRM</button>
                                                <button ng-show = "visit.showContact" class="contact-sales-button" ng-click="showPhone(visit)">Contact :- +91 {{visit.Project__r.Owner.Phone}}</button>
                                                <button class="schedule-visit-button" ng-click = "showDetails(visit)">View Details</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
