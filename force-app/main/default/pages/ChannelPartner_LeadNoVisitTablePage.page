            background-color: #28a745;
            color: white;
        }

        .not-interested {
            background-color: #dc3545;
            color: white;
        }

        .back-link {
            display: flex;
            align-items: center;
            font-weight: 600;
            color: #0B1E35;
            text-decoration: none;
            margin-bottom: 20px;
        }

        .back-link i {
