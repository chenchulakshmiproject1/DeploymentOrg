<apex:page showHeader="false" standardStylesheets="false" sidebar="false" docType="html-5.0">
    <style>
        .content-css {
            border-radius: 10px;
            background-color: #333;
            color: #fff;
        }

        .modal-header {
            border-bottom: none;
            padding-bottom: 0;
        }

        .title-modal {
            font-weight: 600;
            font-size: 20px;
        }

        .body-css {
            padding-top: 0!important;
            font-size: 14px!important;
            color: #ccc!important;
        }

        .share-icons {
            display: flex;
            justify-content: space-around;
            padding: 15px 0;
        }

        .share-icons a {
            color: #fff;
            font-size: 24px;
            text-decoration: none;
        }

        .share-icons a:hover {
            opacity: 0.8;
        }

        .copy-link {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            background-color: #444;
            border-radius: 5px;
            color: #fff;
            margin-top: 10px;
        }

        .copy-link input {
            border: none;
            background-color: transparent;
            color: #fff;
            flex: 1;
            margin-right: 10px;
        }

        .copy-link button {
            background-color: #9D6200;
            border: none;
            color: #fff;
            padding: 5px 10px;
            border-radius: 5px;
        }
    </style>

    <div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content content-css">
                <div class="modal-header">
                    <h5 class="title-modal" id="shareModalLabel">Share</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body body-css">
                    <p>Share our exclusive project listings with your network on WhatsApp, Instagram, Facebook, X, and more. Help your clients discover their dream properties with SNN EstatesEnhance your business by connecting people to the best real estate opportunities!</p>
                    <div class="share-icons">
                        <a class="btn btn-primary" style="background-color: #25d366;border-radius: 50%;width: 52px;height: 52px;border: 0px;" href="#!" role="button"><i class="fab fa-whatsapp"></i></a>
                        <a class="btn btn-primary" style="background-color: #3b5998;border-radius: 50%;width: 52px;height: 52px;border: 0px;" href="#!" role="button"><i class="fab fa-facebook-f"></i></a>
                        <a class="btn btn-primary" style="background-color: #55acee;border-radius: 50%;width: 52px;height: 52px;border: 0px;" href="#!" role="button"><i class="fab fa-twitter"></i></a>
                        <a class="btn btn-primary" style="background-color: #EA4335;border-radius: 50%;width: 52px;height: 52px;border: 0px;" href="#!" role="button"><i class="fas fa-envelope"></i></a>
                        <a class="btn btn-primary" style="background-color: #ff4500;border-radius: 50%;width: 52px;height: 52px;border: 0px;" href="#!" role="button"><i class="fab fa-reddit-alien"></i></a>
                    </div>
                    <div class="copy-link">
                        <input type="text" value="https://tridasadetails.com/123hdjruwo"  />
                        <button onclick="copyLink()">Copy</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function copyLink() {
            const copyText = document.querySelector('.copy-link input');
            copyText.select();
            document.execCommand("copy");
        }
    </script>
</apex:page>